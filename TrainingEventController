    public static void sendEmailWithAttachement(String subject, string body, List<String> toAddresses, List<String> ccAddresses,
        String fromAddress,String fileName, Blob fileContent){
        if(toAddresses != null){
            Messaging.SingleEmailMessage eMail = new Messaging.SingleEmailMessage();
            eMail.setCcAddresses(ccAddresses);
            eMail.setSubject(subject);
            eMail.setHtmlBody(body);
            eMail.setToAddresses(toAddresses);

            if(fromAddress !=null){
                eMail.setOrgWideEmailAddressId(fromAddress);
            }

            List<Messaging.EmailFileAttachment> emailAttachmentList = new List<Messaging.EmailFileAttachment>();
            if(!String.isEmpty(fileName) && fileContent != null){
                Messaging.EmailFileAttachment emailAttachment = new Messaging.EmailFileAttachment();
                emailAttachment.setFileName(fileName);
                emailAttachment.setBody(fileContent);
                emailAttachmentList.add(emailAttachment);
                eMail.setFileAttachments(emailAttachmentList);
            }
            Messaging.sendEmail(new List<Messaging.SingleEmailMessage>{eMail});
        }
    }

