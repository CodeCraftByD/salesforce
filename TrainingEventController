    @AuraEnabled(cacheable=true)
    public static List<String> getAvailableRecordTypeNamesForSObject(String objectAPIName) {
        List<String> recordTypes = new List<String>();
        if(String.isNotBlank(objectAPIName)) {
            SObjectType objType = ((SObject) Type.forName(objectAPIName).newInstance()).getSObjectType();
            List<RecordTypeInfo> infos = objType.getDescribe().getRecordTypeInfos();
            if (infos.size() > 0) {
                for (RecordTypeInfo info : infos) {
                    if (info.isAvailable() && !info.isMaster()){
                        recordTypes.add(info.getRecordTypeId());
                    }
                }
            }
        }
        return recordTypes;
    }

