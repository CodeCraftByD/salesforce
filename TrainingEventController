    @AuraEnabled(cacheable=true)
    public static Boolean checkRequestSuppliesValidation(Training_Event__c eventRecord) {
        Boolean isRequestSuppliesCreatable = false;
        Set<String> permissionSetApiNamesToCheck = new Set<String>{VTUSAConstants.TRAINING_MANAGER_PERMISSION_SET, 
            VTUSAConstants.TRAINING_TRAINER_PERMISSION_SET, VTUSAConstants.TRAINING_ADMIN_PERMISSION_SET};
        List<PermissionSetAssignment> assignedPermissionSets = permissionSetAssignmentDAOInstance.getPermissionSetAssignemtByPermissionSetName(UserInfo.getUserID(), permissionSetApiNamesToCheck);
        for (PermissionSetAssignment psa : assignedPermissionSets) {
            if(eventRecord.Course_Type__c == VTUSAConstants.COURSE_TYPE_CLASSROOM 
                || eventRecord.Course_Type__c == VTUSAConstants.COURSE_TYPE_VIRTUAL) {
                isRequestSuppliesCreatable = psa.PermissionSet.Name == VTUSAConstants.TRAINING_ADMIN_PERMISSION_SET ? true : false;
            } else {
                isRequestSuppliesCreatable = (psa.PermissionSet.Name == VTUSAConstants.TRAINING_ADMIN_PERMISSION_SET 
                    || psa.PermissionSet.Name == VTUSAConstants.TRAINING_MANAGER_PERMISSION_SET 
                    || psa.PermissionSet.Name == VTUSAConstants.TRAINING_TRAINER_PERMISSION_SET) 
                    ? true : false;
            }
        }
        return isRequestSuppliesCreatable;
    }

    @AuraEnabled
    public static void createSupplyOrderForm(Map<String, Object> supplyOrderDetails) {
        String xml = '';
        String eventId;
        if(supplyOrderDetails != null) {
            xml += '<Object>';
            for(String supplyDetail: supplyOrderDetails.keySet()) {
                if(supplyDetail == 'recordId') {
                    eventId = (String) supplyOrderDetails.get(supplyDetail);
                } else {
                    xml += '<' + supplyDetail + '>' + (String) supplyOrderDetails.get(supplyDetail) + '</' + supplyDetail + '>';
                } 
            }

            Training_Event__c trainingEvent = trainingEventDAOInstance.getTrainingEventsAndEventSupplies(eventId);
            List<Event_Trainer__c> eventTrainers = eventTrainerDAOInstance.getEventTrainers(trainingEvent.Id);
            List<String> trainerNames = new List<String>();
            List<String>  carbonCopyAddress = new List<String>();
            for(Event_Trainer__c eventTrainerObj : eventTrainers) {
                trainerNames.add(eventTrainerObj.Trainer1__r.Name);
                carbonCopyAddress.add(eventTrainerObj.Trainer1__r.Email);
            }
            String trainers = String.join(trainerNames, ',');

            xml += '<SObjectId>' + trainingEvent.Id + '</SObjectId>';
            xml += '<SObjectType>' + 'Training_Event__c' + '</SObjectType>';
            xml += '<EventName>' + trainingEvent.Name + '</EventName>';
            xml += '<TrainerName>' + trainers + '</TrainerName>';
            xml += '<AccountName>' + trainingEvent.Account__r.Name + '</AccountName>';
            xml += '<DateOfEvent>' + trainingEvent.Start_Date__c.formatGmt('yyyy-MM-dd') + '</DateOfEvent>';
            
            if(trainingEvent.Event_Supplies__r != null && !trainingEvent.Event_Supplies__r.isEmpty()) {
                xml += '<Materials>';
                for(Event_Supplies__c eventSupply: trainingEvent.Event_Supplies__r) {
                    xml += '<Material>';
                    xml += '<Id>' + eventSupply.Id + '</Id>';
                    xml += '<Name>' + eventSupply.Supply_Name__r.Name + '</Name>';
                    xml += '<Quantity>' + eventSupply.Quantity__c + '</Quantity>';
                    xml += '</Material>';
                }
                xml += '</Materials>';
            }                                    
            xml += '</Object>';

            try {
                if(enableDSCLM) {
                    DocuSignCLMUtility.startWorkflow(VTUSAConstants.TRAINING_REQUEST_SUPPLIES_WORKFLOW, xml);
                } else {
                    SpringCM201411 service = new SpringCM201411();
                    service.StartWorkflow(VTUSAConstants.TRAINING_REQUEST_SUPPLIES_WORKFLOW, xml, null);
                }
            } catch(Exception ex) {
                TWGSystemErrors.insertTwgSystemError(TWGSystemErrors.Application.VTUSA, null, 'Training_Event__c', false, 
                    ex, 'TrainingEventController', 'createSupplyOrderForm');
                throw new AuraHandledException(ex.getMessage());
            }
            sendSupplyRequestOrderEmail(trainingEvent, carbonCopyAddress, trainers);
        }
    }


