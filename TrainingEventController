    @AuraEnabled(cacheable=true)
    public static Boolean validateEventEditable(Id recordId, String status){
        Boolean eventEditValid = false;
        Set<Id> actorQueueIds = new Set<Id>();
        List<GroupMember> groupMembers = new List<GroupMember>();
        if(recordId != null){
            List<ProcessInstanceWorkitem> workItems = 
                processInstanceWorkitemDAOWithoutSharingInstance.getUnApprovedProcessInstanceWorkitemByTargetObjectId(
                new List<String>{recordId});
            if(!workItems.isEmpty()){
                for(ProcessInstanceWorkitem workItem: workItems){
                    actorQueueIds.add(workItem.ActorId);
                }
            } else {
                eventEditValid = true;
            }
            if(!actorQueueIds.isEmpty()){
                groupMembers = groupMemberWithoutSharingDAOInstance.getGroupMembersByGroupIds(actorQueueIds);
            }
            if(!groupMembers.isEmpty()){
                for(GroupMember member: groupMembers){
                    if(member.UserOrGroupId == UserInfo.getUserID()) {
                        eventEditValid = true;
                        break;
                    }
                }
            }
            if(status == VTUSAConstants.TRAINING_EVENT_PENDING_STATUS){
                List<PermissionSetAssignment> permissionSetAssignmentList = 
                    permissionSetAssignmentDAOInstance.getPermissionSetAssignemtByPermissionSetName((Id)UserInfo.getuserId(), 
                    new Set<String>{PermissionSetConstants.TRAINING_EVENT_TRAINER_PERMISSIONS});
                if(permissionSetAssignmentList.size() > 0){
                    eventEditValid = true;
                }
            }
        }
        return eventEditValid;
    }

