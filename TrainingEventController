    @InvocableMethod
    public static void submitForUnlockApprovalForPendingStatus(List<Id> recordId){
        try{
            if(recordId.size() > 0 && String.isNotEmpty(parentId)){
                getEventByRecordById = trainingEventDAOInstance.getTrainingEventById(parentId);
                getEventByRecordList = new List<Training_Event__c>{getEventByRecordById};
                String pendingStatusSubject = subject.stripHtmlTags();
                String subjectappendBodyAfter = pendingSatusEmailBody.substringAfter(':');
                String subjectappendBodyBefore = pendingSatusEmailBody.substringBefore(':');
                String stringOrganizationId = UserInfo.getOrganizationId(); 
                List<String> carbonCopySendingEmail = new List<String>{distributionListEmailAddress}; 
                List<OrgWideEmailAddress> orgWideEmailId = OrgWideEmailAddressDAO.getOrgWideEmailAddressFromVTUSASettings();
                List<String> approvalMailLink = new List<String>{
                    inboundEmail, 
                    getEventByRecordById.Event_Name__c
                        .replaceAll(VTUSAConstants.SYMBOL_AMPERSAND, VTUSAConstants.ASCII_AMPERSAND)
                        + VTUSAConstants.ASCII_BAR + VTUSAEmailService.encryptData(getEventByRecordById.Id),
                    VTUSAConstants.TRAINIG_EVENT_APPROVAL_BODY, VTUSAConstants.TRAINIG_EVENT_APPROVAL_LINK
                };
                List<String> rejectMailLink = new List<String>{
                    inboundEmail, 
                    getEventByRecordById.Event_Name__c
                        .replaceAll(VTUSAConstants.SYMBOL_AMPERSAND, VTUSAConstants.ASCII_AMPERSAND)
                        + VTUSAConstants.ASCII_BAR + VTUSAEmailService.encryptData(getEventByRecordById.Id),
                    VTUSAConstants.TRAINIG_EVENT_REJECT_BODY, VTUSAConstants.TRAINIG_EVENT_REJECT_LINK
                };
                List<Document> lstDocument = documentDAOInstance.getDocumentsByFolderIdOrderByDescription(folderId);
                for(Document docObj:lstDocument)
                {
                    if(docObj.DeveloperName.equalsIgnoreCase(VTUSAConstants.DOCUMENT_EMAIL_HEADER)){
                        headerUrl = instanceUrl.imageURL + VTUSAConstants.DOCUMENT_URL +
                            lstDocument[0].Id + VTUSAConstants.ORG_ID + stringOrganizationId;
                    }
                    else if(docObj.DeveloperName.equalsIgnoreCase(VTUSAConstants.DOCUMENT_EMAIL_FOOTER)){
                        footerUrl = instanceUrl.imageURL + VTUSAConstants.DOCUMENT_URL +
                            lstDocument[1].Id + VTUSAConstants.ORG_ID + stringOrganizationId;
                    }
                }
                List<String> headerFooterLink=new List<String>{headerUrl,FooterUrl};
                String originalBody=String.format(VTUSAConstants.TRAINING_EVENT_EMAIL_HEADER,headerFooterLink) +
                    subjectappendBodyBefore + String.format(VTUSAConstants.TRAINING_EVENT_APPROVAL_MAIL_LINK, approvalMailLink) +
                    String.format(VTUSAConstants.TRAINING_EVENT_REJECTED_MAIL_LINK, rejectMailLink) + subjectappendBodyAfter +
                    String.format(VTUSAConstants.TRAINING_EVENT_EMAIL_FOOTER,headerFooterLink);
                Messaging.SingleEmailMessage message = new Messaging.SingleEmailMessage();
                message.setOrgWideEmailAddressId(orgWideEmailId[0].Id);
                message.setToAddresses(PermissionSetAssignmentIdsEmail);
                message.setHtmlBody(originalBody);
                message.setSubject(pendingStatusSubject);
                message.setSaveAsActivity(false);
                message.setCcAddresses(carbonCopySendingEmail);
                Messaging.SingleEmailMessage[] messages = new List<Messaging.SingleEmailMessage> {message};
                Messaging.sendEmail(messages);
            }
            else{
                throw new AuraHandledException(System.Label.Text_You_Do_Not_Have_Permissions_To_Perform_This_Operation);
            }
        }
        catch (Exception exceptionObj) {
            TWGSystemErrors.insertTwgSystemError(TWGSystemErrors.Application.VTUSA, null, 'User', false, exceptionObj,
                'TrainingEnrollmentController', 'submitForUnlockApprovalForPendingStatus');
            throw new AuraHandledException(exceptionObj.getMessage());
        }
    }

