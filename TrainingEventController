    @AuraEnabled
    public static void cancelEnrollment(Id enrollmentId) {
        try {
            if (enrollmentId == null) {
                throw new AuraHandledException('Invalid enrollment.');
            }
            Enrollment__c enrollmentRec =
                enrollmentDAOInstance.getEnrollmentForCancellation(enrollmentId);
                
            if (enrollmentRec.Event_Id__r.Event_Start_Date__c <= System.now()) {
                throw new AuraHandledException('Event already started. Cancellation is not allowed.');
            }
            if (enrollmentRec.Status__c == VTUSAConstants.ENROLLMENT_CANCELLED_STATUS) {
                throw new AuraHandledException('Enrollment is already cancelled.');
            }
            Set<String> setOfTransactionStatus = new Set<String>{PaymentTransactionConstants.PAYMENT_TRANSACTION_STATUS_SUCCESS};
            List<Payment_Transaction__c> listOfPaymentTransaction = new List<Payment_Transaction__c>();
            listOfPaymentTransaction = paymentTransactionDAOInstance.getPaymentTransactionsByTransactionTypeAndStatus(enrollmentId, 
                PaymentTransactionConstants.TRANSACTION_TYPE_TRAINING_FUND, setOfTransactionStatus);

            if(listOfPaymentTransaction.size() > 0) {
                Payment_Transaction__c refundPaymentTransactionInst = listOfPaymentTransaction[0].clone(false, true, false, false);
                refundPaymentTransactionInst.Transaction_Type__c =PaymentTransactionConstants.TRANSACTION_TYPE_REFUND;
                refundPaymentTransactionInst.Special_ID__c =  generatePaymentTransactionUniqueReference();
                refundPaymentTransactionInst.RecordTypeId = PaymentTransactionConstants.PAYMENT_TRANSACTION_TRAINING_RECORD_TYPE_ID;

                processEnrollmentRefund(refundPaymentTransactionInst, enrollmentRec);


            }else{
                enrollmentRec.Status__c = VTUSAConstants.ENROLLMENT_CANCELLED_STATUS;
                enrollmentRec.Is_RD_Created__c = false;
                update enrollmentRec;

            }
            

        } catch (Exception ex) {
            TWGSystemErrors.insertTwgSystemError(TWGSystemErrors.Application.VTUSA, enrollmentId, 'Enrollment__c',
                false,ex,'TrainingEventController','cancelEnrollment');
            throw new AuraHandledException(ex.getMessage());
        }
    }

    private static String generatePaymentTransactionUniqueReference() {
        String timestamp = Datetime.now().format('yyyyMMddHHmmss');
        String randomNumber = String.valueOf(Math.abs(Crypto.getRandomLong())).substring(0, 10);
        return 'PT' + timestamp + randomNumber;
    }

 
    public static void processEnrollmentRefund(
        Payment_Transaction__c refundPaymentTransactionInst,Enrollment__c enrollmentRec) {

        String MERCHANT_ID = VTUSA_Settings__c.getInstance().Training_Merchant_ID__c ;
        String HOST = VTUSA_Settings__c.getInstance().Cybersource_Rest_API_Host__c;
        String SHARED_SECRET = VTUSAEmailService.decryptData(
            VTUSA_Settings__c.getInstance().Cybersource_Rest_API_SharedSecret__c);
        String errorMessage = null;
        
        String transactionId = refundPaymentTransactionInst.Transaction_Id__c;
        String resourcePath = '/pts/v2/payments/' + transactionId + '/refunds';
        String url = 'https://' + HOST + resourcePath;
        
        Map<String, Object> amountDetailsMap = new Map<String, Object>{
            'totalAmount' => refundPaymentTransactionInst.Amount__c,
            'currency' => refundPaymentTransactionInst.CurrencyIsoCode
        };

        Map<String, Object> orderInformationMap = new Map<String, Object>{
            'amountDetails' => amountDetailsMap
        };

        Map<String, Object> clientReferenceMap = new Map<String, Object>{
            'code' => refundPaymentTransactionInst.Special_ID__c
        };

        Map<String, Object> bodyMap = new Map<String, Object>{
            'clientReferenceInformation' => clientReferenceMap,
            'orderInformation' => orderInformationMap
        };
        String requestBody = JSON.serialize(bodyMap);
 
        String gmtDate = DateTime.now().formatGmt('EEE, dd MMM yyyy HH:mm:ss z');
        Blob digestBlob = Crypto.generateDigest('SHA-256', Blob.valueOf(requestBody));
        String digestHeader = 'SHA-256=' + EncodingUtil.base64Encode(digestBlob);
 
        String signatureString = 'host: ' + HOST + '\n' +
            'date: ' + gmtDate + '\n' +
            'request-target: post ' + resourcePath + '\n' +
            'digest: ' + digestHeader + '\n' +
            'v-c-merchant-id: ' +  MERCHANT_ID;
 
        Blob secretKey = EncodingUtil.base64Decode(SHARED_SECRET);
        Blob signatureBlob = Crypto.generateMac('HmacSHA256', 
            Blob.valueOf(signatureString), secretKey);
        String signatureHash = EncodingUtil.base64Encode(signatureBlob);
 
        String signatureHeader = 'keyid="' + VTUSAEmailService.decryptData(
            VTUSA_Settings__c.getInstance().Cybersource_Rest_API_Key__c) 
            + '", ' +
            'algorithm="HmacSHA256", ' +
            'headers="host date request-target digest v-c-merchant-id", ' +
            'signature="' + signatureHash + '"';
 
        HttpRequest requestData = new HttpRequest();
        requestData.setEndpoint(url);
        requestData.setMethod('POST');
        requestData.setHeader('v-c-merchant-id',  MERCHANT_ID);
        requestData.setHeader('Date', gmtDate);
        requestData.setHeader('Host', HOST);
        requestData.setHeader('Digest', digestHeader);
        requestData.setHeader('Signature', signatureHeader);
        requestData.setHeader('Content-Type', 'application/json');
        requestData.setBody(requestBody);
 
        Http http = new Http();
        HttpResponse response = http.send(requestData);
        RefundResponse refundResp ;
        try {
            refundResp = (RefundResponse) JSON.deserialize(response.getBody(),
                RefundResponse.class);
            if(response.getStatusCode() == 201){
                String refundId = refundResp.id;
                String status = refundResp.status;
                Decimal refundAmount = refundResp.refundAmountDetails.refundAmount;
                String responseCode = refundResp.processorInformation.responseCode;
                String reconciliationId = refundResp.reconciliationId;
                if(responseCode == '100') {
                    refundPaymentTransactionInst.Status__c = 
                        PaymentTransactionConstants.PAYMENT_TRANSACTION_STATUS_SUCCESS;
                    refundPaymentTransactionInst.Transaction_Id__c = refundId;
                } else {
                    refundPaymentTransactionInst.Status__c = 
                        PaymentTransactionConstants.PAYMENT_TRANSACTION_STATUS_FAILED;
                    errorMessage = Label.Error_Internal_Server_Error;
                }

            } 
            else {
                refundPaymentTransactionInst.Status__c 
                    = PaymentTransactionConstants.PAYMENT_TRANSACTION_STATUS_FAILED;
                refundPaymentTransactionInst.Transaction_Id__c = null;
                if (refundResp.errorInformation != null) {
                    refundPaymentTransactionInst.Long_Description__c 
                        = refundResp.errorInformation.message;
                }else {
                    refundPaymentTransactionInst.Long_Description__c 
                        = refundResp.status;
                }
                errorMessage = Label.Error_Internal_Server_Error;
            }
            paymentTransactionDAOInstance.insertPaymentTransactions(
                new List<Payment_Transaction__c>{refundPaymentTransactionInst});
            
            if(refundPaymentTransactionInst.Status__c ==
                PaymentTransactionConstants.PAYMENT_TRANSACTION_STATUS_SUCCESS){
                TrainingCybersourceWebService.insertAccountPaymentForCancellation(
                    refundPaymentTransactionInst);
                enrollmentRec.Status__c = VTUSAConstants.ENROLLMENT_CANCELLED_STATUS;
                enrollmentRec.Is_RD_Created__c = false;
                enrollmentDAOInstance.upsertEnrollmentRecordList(new List<Enrollment__c>{enrollmentRec}) ;
            }else{
                throw new AuraHandledException(errorMessage);
            }
        } catch(Exception ex) {
            ex = UtilityDAO.getBaseDAOPrimaryException(ex);
            TWGSystemErrors.insertTwgSystemError(TWGSystemErrors.Application.VTUSA, null,
                'Cybersource', false, ex, TrainingEventController.Class.getName(),
                'processEnrollmentRefund');
        }
    }

