    public LeadPDFController() {
        leadId = ApexPages.currentPage().getParameters().get('id');
        if (leadId != null) {
            // Fetch Lead safely
            List<Lead__c> leadList = [
                SELECT Id,
                       Customer_Name__c, Name,
                       Contact_Number__c,Agent_Id_Formula__c,
                       CreatedBy.Branch__c,
                       CreatedBy.MobilePhone,
                       CreatedBy.Name,
                       Account_Name__r.Id,
                       Account_Name__r.OwnerId, 
                       Account_Name__r.Name,
                       Account_Name__r.BillingStreet,
                       Account_Name__r.BillingCity,
                       Account_Name__r.BillingState,
                       Account_Name__r.BillingPostalCode,
                       Account_Name__r.BillingCountry
                FROM Lead__c
                WHERE Id = :leadId
                LIMIT 1
            ];
            if (!leadList.isEmpty()) {
                lead = leadList[0];

                // Fetch TL & SM Phone numbers safely
                if (lead.Account_Name__r != null && lead.Account_Name__r.OwnerId != null) {
                    List<User> tlList = [SELECT Id, MobilePhone, UserRoleId, IsActive FROM User WHERE Id = :lead.Account_Name__r.OwnerId LIMIT 1];
                    if (!tlList.isEmpty()) {
                        User tlUser = tlList[0];
                        if (tlUser.IsActive) tlPhone = tlUser.MobilePhone;

                        if (tlUser.UserRoleId != null) {
                            List<UserRole> tlRoleList = [SELECT ParentRoleId FROM UserRole WHERE Id = :tlUser.UserRoleId LIMIT 1];
                            if (!tlRoleList.isEmpty() && tlRoleList[0].ParentRoleId != null) {
                                List<User> smList = [SELECT MobilePhone FROM User WHERE UserRoleId = :tlRoleList[0].ParentRoleId AND IsActive = true LIMIT 1];
                                if (!smList.isEmpty()) smPhone = smList[0].MobilePhone;
                            }
                        }
                    }
                }

                // Fetch Opportunity Products
                oppProducts = [
                    SELECT Id,
                           Lead__c,
                           Product__c,
                           Product__r.Name,
                           Nil_Dep_IMT_23__c,
                           Fastag_Radium__c,
                           CreatedDate,
                           Ex_Showroom_Price__c,
                           Net_on_road_Price__c,
                           RTO_Charges_inclu_ding_Permit_in_BD__c,
                           Steering__c,
                           Enter_Discount__c,
                           Incidental_charges_Logistics_charge__c,
                           TCS_1__c,
                           On_Road_Price__c
                    FROM Opportunity_Product__c
                    WHERE Lead__c = :leadId
                    ORDER BY CreatedDate ASC
                ];

                if (!oppProducts.isEmpty()) {
                    firstOppProduct = oppProducts[0];
                    exShowRoomPrice = NumberFormatter.formatToIndianStyle(firstOppProduct.Ex_Showroom_Price__c);
                    insurance = NumberFormatter.formatToIndianStyle(firstOppProduct.Nil_Dep_IMT_23__c);
                    roadTax = NumberFormatter.formatToIndianStyle(firstOppProduct.RTO_Charges_inclu_ding_Permit_in_BD__c);
                    fastag = NumberFormatter.formatToIndianStyle(firstOppProduct.Fastag_Radium__c);
                    logisticChages = NumberFormatter.formatToIndianStyle(firstOppProduct.Incidental_charges_Logistics_charge__c);
                    tcs = NumberFormatter.formatToIndianStyle(firstOppProduct.TCS_1__c);
                    roadPrice = NumberFormatter.formatToIndianStyle(firstOppProduct.On_Road_Price__c);
                }
            }
        }
    }

