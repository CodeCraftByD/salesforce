        ];
    }
    
    static Billing_Item__c getBillingItemByAccountingActionName(String accountingActionName) {
        return [
            SELECT Id, Balance_Remaining__c, Invoice__c, Client__c, Escrow_Balance_Remaining__c, Escrow_Funded_Date__c, Escrow_Funded__c 
            FROM Billing_Item__c
            WHERE RD_Transaction__r.Accounting_Action__r.Name = :accountingActionName
