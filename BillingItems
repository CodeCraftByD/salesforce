    public List<Billing_Item__c> getBillingItemsForDealerHeld(List<Account_Payment__c> listOfNewAccountPayments){
        Set<String> SET_OF_RECORD_TYPE_DEVELOPER = new Set<String> {
            ContractEventConstants.NEW_BUSINESS_EVENT_TYPE, BillingItemConstants.BILLING_ITEM_RECORD_TYPE_CONTRACT
        };
        Set<String> SET_OF_SOBJECT_TYPE_DEVELOPER = new Set<String> {
            ContractEventConstants.CONTRACT_EVENT_OBJECT_NAME, BillingItemConstants.BILLING_ITEM_API_NAME
        };
        Map<String, Id> mapOfDeveleporNameWithRecordTypeId = new Map<String, Id>();
        List<RecordType> listOfRecordTypes = RecordTypeDAO.getRecordTypes(
            SET_OF_RECORD_TYPE_DEVELOPER, SET_OF_SOBJECT_TYPE_DEVELOPER);  
        for (RecordType recordType : listOfRecordTypes) {
            mapOfDeveleporNameWithRecordTypeId.put(recordType.DeveloperName, recordType.Id);
        }
        Set<Id> setOfContractIds = new Set<Id>();
        List<Billing_Item__c> listOfBillingItems = new List<Billing_Item__c>();
        Map<Id, Id> mapOfContractIdWithContractEventId = new Map<Id, Id>();
        Billing_Item__c billingItemsInstance;
        
        for(Account_Payment__c accountPayment : listOfNewAccountPayments){
            for(Payments_And_Documents__c paymentsAndDocument : accountPayment.Payments_And_Documents__r) {
                if(paymentsAndDocument.Contract__c != null && 
                    ContractConstants.CUSTOMERDD_PAYMENTMETHOD.equalsIgnoreCase(paymentsAndDocument.Contract__r.Payment_Method_s__c) && 
                    paymentsAndDocument.Contract__r.Quote_Dealer_Product__r.Dealer_Product__r.TWG_Product__r.Dealer_Held_Funds__c) {   
                            
                    setOfContractIds.add(paymentsAndDocument.Contract__c);
                }
            }
        }
        List<Contract_Event__c> listOfContractEvents = eventDaoWithoutSharingInstance.getContractEventByContractsAndType(
            setOfContractIds, mapOfDeveleporNameWithRecordTypeId.get(ContractEventConstants.NEW_BUSINESS_EVENT_TYPE));
        for(Contract_Event__c contractEvent : listOfContractEvents) {
            mapOfContractIdWithContractEventId.put(contractEvent.Contract__c, contractEvent.Id);
        }
        for(Account_Payment__c accountPayment : listOfNewAccountPayments){
            for(Payments_And_Documents__c paymentsAndDocument : accountPayment.Payments_And_Documents__r) {
                if(paymentsAndDocument.Contract__c != null && 
                    ContractConstants.CUSTOMERDD_PAYMENTMETHOD.equalsIgnoreCase(paymentsAndDocument.Contract__r.Payment_Method_s__c) && 
                    paymentsAndDocument.Contract__r.Quote_Dealer_Product__r.Dealer_Product__r.TWG_Product__r.Dealer_Held_Funds__c) {   
                            
                    billingItemsInstance = new Billing_Item__c();
                    billingItemsInstance.RecordTypeId =
                        mapOfDeveleporNameWithRecordTypeId.get(BillingItemConstants.BILLING_ITEM_RECORD_TYPE_CONTRACT);
                    billingItemsInstance.Statement_Type__c = BillingItemConstants.STATEMENT_TYPE_ITEM_BALANCE;
                    billingItemsInstance.Type__c = BillingItemConstants.BILLING_DEALER;
                    billingItemsInstance.CurrencyISOCode = accountPayment.CurrencyISOCode;
                    billingItemsInstance.Account_Payment__c = accountPayment.Id;
                    billingItemsInstance.Client__c = paymentsAndDocument.Contract__r.Account_Name__c;
                    billingItemsInstance.Amount__c = accountPayment.Total_Transaction_Value__c - 
                        (paymentsAndDocument.Admin_Fee__c + paymentsAndDocument.Tax_Admin_Fee__c);
                    billingItemsInstance.Balance_Remaining__c = billingItemsInstance.Amount__c;
                    billingItemsInstance.GL_Mapping_Type__c = 
                        paymentsAndDocument.Contract__r.Quote_Dealer_Product__r.Dealer_Product__r.TWG_Product__r.GL_Mapping_Type__c;
                    billingItemsInstance.AIM_Client_Code__c = paymentsAndDocument.Contract__r.ClientNumber_INT__c;
                    billingItemsInstance.Obligor_Code__c = paymentsAndDocument.Contract__r.Obligor_Code__c;
                    billingItemsInstance.Contract_Event__c = mapOfContractIdWithContractEventId.get(paymentsAndDocument.Contract__c);
                    listOfBillingItems.add(billingItemsInstance);
                }
            }
        }
        return listOfBillingItems;
    }
	
    public static void calculateTotalOnPassedBillStatementsFromBillItems(List<Billing_Statements__c> billingStatementList) {
        List<Billing_Item__c> allBillingItemsList = new List<Billing_Item__c>();
        String strQuery =
            +' SELECT Id, Billing_Statement__c, RecordtypeId , Amount__c, Case_Payee__r.Payment_Method__c,'
            +    ' Invoice__r.Billing_Statement__r.Client_Name__r.Billing_Type__c, Invoice__r.Billing_Statement__c,'
            +    ' Statement_Amount__c, Contract_Event__r.Contract__r.Contract_Type_new__c, Net_Oon_Case_Payee__c, Contract_Event__r.Contract__r.Detail_Type_INT__c'
            +' FROM Billing_Item__c'
            +' WHERE (Amount__c != 0 OR Statement_Amount__c != null)'
            +' AND Invoice__r.Billing_Statement__c IN : billingStatementList'
            +' AND('
            +' ('
            +' Invoice__r.Billing_Statement__r.Client_Name__r.Billing_Type__c IN'+
            CalculateBillingItemsTotalsBatch.CORPORATE_BILLTYPE_SET
            +' AND';
        strQuery = setFiltersForCorporate(strQuery);
        strQuery +=')'
            +' OR('
            +' Invoice__r.Billing_Statement__r.Client_Name__r.Billing_Type__c IN'
            + CalculateBillingItemsTotalsBatch.NON_CORPORATE_BILLTYPE_SET
            +' AND';
        strQuery = setFiltersForNonCorporate(strQuery);
        strQuery +=')'
            +' )';
        allBillingItemsList = Database.Query(strQuery); //NOPMD
        if(CalculateBillingItemsTotalsBatch.useMock){
            allBillingItemsList = CalculateBillingItemsTotalsBatch.mockBillItemsList;
        }
        Map<Id,Billing_Statements__c> billingStatementMap = new Map<Id,Billing_Statements__c>();
        Billing_Statements__c objBillStatement = new Billing_Statements__c();
        for(Billing_Item__c objBillItem : allBillingItemsList){
            if(objBillItem.Invoice__c != null) {
                if(billingStatementMap.containsKey(objBillItem.Invoice__r.Billing_Statement__c)) {
                    objBillStatement = billingStatementMap.get(objBillItem.Invoice__r.Billing_Statement__c);
                } else {
                    objBillStatement = new Billing_Statements__c(Id=objBillItem.Invoice__r.Billing_Statement__c,
                        Total_Premium__c=0, Total_R_D_s__c=0, Total_Netted_Claims__c=0, Total_Out_of_Network_Claims__c=0);
                }
            }
            if(objBillItem.RecordtypeId == BillingItemConstants.BILLING_ITEM_CONTRACT_RECORD_TYPE_ID) {
                Boolean isChildMC;
                if(objBillItem.Invoice__c != null) {
                    isChildMC = objBillItem.Contract_Event__r.Contract__r.Contract_Type_new__c ==
                        ContractConstants.CONTRACT_TYPE_MOTOR_CLUB &&
                        objBillItem.Contract_Event__r.Contract__r.Detail_Type_INT__c ==
                        ContractConstants.DETAIL_TYPE_CHILD_CONTRACT
                        && CalculateBillingItemsTotalsBatch.CORPORATE_BILLTYPE_SET.contains(
                        objBillItem.Invoice__r.Billing_Statement__r.Client_Name__r.Billing_Type__c);
                }
                if(objBillItem.Contract_Event__r.Contract__r.Contract_Type_new__c == ContractConstants.CONTRACT_TYPE_LIMITED_WARRANTY 
                    && objBillItem.Statement_Amount__c != null) {
                    objBillStatement.Total_Premium__c += objBillItem.Statement_Amount__c;
                }
                else if(!isChildMC){
                    objBillStatement.Total_Premium__c += objBillItem.Amount__c;
                }
            }
            if(objBillItem.RecordtypeId == BillingItemConstants.BILLING_ITEM_RD_TRANSACTION_RECORD_TYPE_ID){
                objBillStatement.Total_R_D_s__c += objBillItem.Amount__c;
            }
            if(objBillItem.RecordtypeId == BillingItemConstants.BILLING_ITEM_CLAIM_RECORD_TYPE_ID){
                if(objBillItem.Case_Payee__r.Payment_Method__c == CasePayeeConstants.NET_PAYMENT_METHOD && objBillItem.Net_Oon_Case_Payee__c == false)
                    objBillStatement.Total_Netted_Claims__c += objBillItem.Amount__c;
                else if((objBillItem.Case_Payee__r.Payment_Method__c <> CasePayeeConstants.NET_PAYMENT_METHOD) || objBillItem.Net_Oon_Case_Payee__c == true)
                    objBillStatement.Total_Out_of_Network_Claims__c += objBillItem.Amount__c;
            }
            if(objBillItem.Invoice__c != null) {
                billingStatementMap.put(objBillItem.Invoice__r.Billing_Statement__c, objBillStatement);
            }
        }
        if(!billingStatementMap.isEmpty()){
            if(!CalculateBillingItemsTotalsBatch.useMock){
                billingStatementDAOInstance.updateBillingStatementList(billingStatementMap.values());
            }else
                CalculateBillingItemsTotalsBatch.mockStatementList = billingStatementMap.values();
        } else if(CalculateBillingItemsTotalsBatch.useMock){
            CalculateBillingItemsTotalsBatch.mockStatementList = billingStatementList;
        }
    }
	
