            mapGLMappingAndObligorCode.put(glMappingType, obligorCode);

            initialAmount = billingStatement.Billing_Items__r[billingItemCounter].Amount__c;
            if (mapGLMappingAndAmount.isEmpty()) {
                mapGLMappingAndAmount.put(glMappingType, initialAmount);      
            } else {
                if (mapGLMappingAndAmount.containsKey(glMappingType)) {
                    initialAmount += mapGLMappingAndAmount.get(glMappingType);
                }
                mapGLMappingAndAmount.put(glMappingType, initialAmount);
            }
			billingItemCounter++;
        }

        Decimal amountOnAP = reverseBillingAmount;
        Decimal amountBasedOnGLMapping ;
        Decimal totalAmountOnBillingStatement = billingStatement.Outstanding_Amount__c;
        Decimal totalAmount =0.0;
        Integer counter=0;
        for(String glMappingName : mapGLMappingAndAmount.keySet()) {
            counter++;
            amountBasedOnGLMapping = mapGLMappingAndAmount.get(glMappingName);
            Decimal amountONBillingItem = ((amountOnAP / totalAmountOnBillingStatement) * amountBasedOnGLMapping).setScale(2);
            if (isBSPaid) {
                amountOnBillingItem = paymentsAndDocumentsDomain.checkForRoundOffDifferenceForPnDAndBI(
                    mapOfBSIdPerGLMappingToTotalAmount, billingStatement.Id + '_' + glMappingName, amountBasedOnGLMapping, amountOnBillingItem);
            }
            totalAmount+=amountONBillingItem;
            if( counter==mapGLMappingAndAmount.size() ) {
                if( Math.abs(totalAmount) < Math.abs(amountOnAP) ) {
                    Decimal difference = Math.abs(amountOnAP) - Math.abs(totalAmount);
                    if(amountOnAP < 0) {
                        amountONBillingItem -= difference;
                    } else {
                        amountONBillingItem += difference;
                    }
                }
            }
            mapGLMappingAndAmount.put(glMappingName,amountONBillingItem);
        }
        
        for (String glMappingName : mapGLMappingAndAmount.keySet()) {
            Billing_Item__c billingItem = new Billing_Item__c();
            billingItem.recordTypeId = recordTypeId;
            billingItem.Statement_Type__c = statementType;
            if (!accountPayment.Payments_And_Documents__r.isEmpty() && 
			    accountPayment.Payments_And_Documents__r[0].Contract__c != null) {
                billingItem.Client__c = accountPayment.Payments_And_Documents__r[0].Contract__r.Account_Name__c;
            } else {
                billingItem.Client__c = accountPayment.Dealer_Account__c;
            }
            String reconciliationRef = setReconciliationTypeOnBillingItem(accountPayment, billingItem, statementType, 
                parentAccountNumber, accountPayment.Dealer_Account__r.AccountNumber);
            String branding = accountPayment.Dealer_Account__r.Branding__r.Manufacturer__c;
            Boolean isHonda = (BrandingConstants.BRANDING_HONDA.equalsIgnoreCase(branding) ||
                BrandingConstants.BRANDHONDA.equalsIgnoreCase(branding)) ? true : false;
            String paymentMethod = billingStatement.Billing_Items__r.size() > 0 ?
                billingStatement.Billing_Items__r[0].Contract_Event__r.Contract__r.Payment_method_s__c : null;
            billingItem.Account_Payment__c = accountPayment.Id;
            billingItem.Balance_Remaining__c = 0;
            billingItem.GL_Mapping_Type__c = glMappingName;
            billingItem.CurrencyIsoCode = accountPayment.CurrencyIsoCode;
            billingItem.Amount__c = mapGLMappingAndAmount.get(glMappingName);
            billingItem.AIM_Client_Code__c = billingStatement.Billing_Items__r.size() > 0 ?
                billingStatement.Billing_Items__r[0].Contract_Event__r.Contract__r.ClientNumber_INT__c : null;
            billingItem.Obligor_Code__c = billingStatement.Billing_Items__r.size() > 0 ? mapGLMappingAndObligorCode.get(glMappingName) : null;
            if(paymentMethod != null && ContractConstants.SINGLEPREMIUM_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                billingItem.GL_Payment_Code__c = BillingItemConstants.SINGLE_PREMIUM_GL_PAYMENT_CODE;
            } else  if (paymentMethod != null && ContractConstants.THIRD_PARTY_INSTALLMENT_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                billingItem.GL_Payment_Code__c = BillingItemConstants.THIRD_PARTY_INSTALLMENT_GL_PAYMENT_CODE;
            } else if (paymentMethod != null && ContractConstants.THIRDPARTYDD_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                billingItem.GL_Payment_Code__c = BillingItemConstants.THIRD_PARTY_DD_GL_PAYMENT_CODE;
