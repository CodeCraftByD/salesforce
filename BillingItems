    public static void createBillingItemForNonFinancialContractEventInstallment(
        List<Contract_Event_Installment__c> contractEventInstallmentList) {
        Id contractRecordTypeId = RecordTypeDAO.getRecordTypeId(BillingItemConstants.BILLING_ITEM_RECORD_TYPE_CONTRACT,
            BillingItemConstants.BILLING_ITEM_API_NAME);
        Set<Id> contractIdSet = New Set<Id>();
        List<Contract_Event_Installment__c> contractEvtInstallmentList = evtInstallmentDaoInstance.getContractEventInstallmentById(
            new List<Id> (Pluck.ids('Id', contractEventInstallmentList)));
        for(Contract_Event_Installment__c contractEventInstallment : contractEvtInstallmentList){
            contractIdSet.add(contractEventInstallment.Contract_Event__r.Contract__c);
        }
        Map<Id,Id> contractIdToBillingItemIdMap = new Map<Id,Id> ();
        Map<Id, List<Map<String, Id>>> contractIdToRecordTypeBillingItemMap = new Map<Id, List<Map<String, Id>>>(); 
        List<Map<String, Id>> contractRecordTypeBillingItemSubMapList; 
        Map<Id, Billing_Item__c> billingItemMap = new Map<Id, Billing_Item__c> ();
        billingItemMap = billingItemDAOInstance.getBillingItemsWithContract(contractIdSet);
        for(Billing_Item__c billingItem : billingItemMap.values()){
            contractRecordTypeBillingItemSubMapList = new List<Map<String, Id>>();
            if(contractIdToRecordTypeBillingItemMap.containsKey(billingItem.Contract_Event__r.Contract__c)){
                contractRecordTypeBillingItemSubMapList = contractIdToRecordTypeBillingItemMap.get(billingItem.Contract_Event__r.Contract__c);
                contractRecordTypeBillingItemSubMapList.add(new Map<String, Id>{billingItem.Contract_Event_Record_Type__c=>billingItem.Id});
                contractIdToRecordTypeBillingItemMap.put(billingItem.Contract_Event__r.Contract__c, contractRecordTypeBillingItemSubMapList);  
            }
            else{
                contractRecordTypeBillingItemSubMapList.add(new Map<String, Id>{billingItem.Contract_Event_Record_Type__c=>billingItem.Id});
                contractIdToRecordTypeBillingItemMap.put(billingItem.Contract_Event__r.Contract__c, contractRecordTypeBillingItemSubMapList);
            }
        }

        List<Billing_Item__c> billingItemList = new List<Billing_Item__c> ();
        Map<Id, Billing_Item__c> updateParentBillingItemMap = new Map<Id,Billing_Item__c> ();
        List<Billing_Item__c> updateParentBillingItemList = new List<Billing_Item__c>();
       
        for(Contract_Event_Installment__c contractEventInstallment :contractEvtInstallmentList){
            Billing_Item__c billingItem = new Billing_Item__c();
            List<Map<String, Id>> parentContractRecordTypeMatchingMapList = new List<Map<String, Id>>();
            ID parentBillingItemIdToUpdateBalanceOn;
            billingItem = createBillingItemFromContractEvtInstallment(contractEventInstallment);
            billingItem.RecordTypeId = contractRecordTypeId;
            
            if(contractEventInstallment.Event_Type__c == ContractEventConstants.EVENT_TYPE_NEW_INSTALLMENT){
                parentContractRecordTypeMatchingMapList = contractIdToRecordTypeBillingItemMap.get(contractEventInstallment.Contract_Event__r.Contract__c);
                for(Map<String, Id> mapIterator : parentContractRecordTypeMatchingMapList){
                    if(mapIterator.containsKey(ContractEventConstants.NEW_BUSINESS_EVENT_TYPE)){
                        billingItem.Parent_Billing_Item__c = mapIterator.get(ContractEventConstants.NEW_BUSINESS_EVENT_TYPE);
                        parentBillingItemIdToUpdateBalanceOn = billingItem.Parent_Billing_Item__c;
                        break;
                    }
                }
            }
            else if(contractEventInstallment.Event_Type__c == ContractEventConstants.EVENT_TYPE_CANCEL_INSTALLMENT){
                parentContractRecordTypeMatchingMapList = contractIdToRecordTypeBillingItemMap.get(contractEventInstallment.Contract_Event__r.Contract__c);
                for(Map<String, Id> mapIterator : parentContractRecordTypeMatchingMapList){
                    if(mapIterator.containsKey(ContractEventConstants.CANCELLATION_EVENT_TYPE)){
                        billingItem.Parent_Billing_Item__c = mapIterator.get(ContractEventConstants.CANCELLATION_EVENT_TYPE);
                        parentBillingItemIdToUpdateBalanceOn = billingItem.Parent_Billing_Item__c;
                        break;
                    }
                }
            }
            else if(contractEventInstallment.Event_Type__c == ContractEventConstants.EVENT_TYPE_REINSTATE_INSTALLMENT){
                parentContractRecordTypeMatchingMapList = contractIdToRecordTypeBillingItemMap.get(contractEventInstallment.Contract_Event__r.Contract__c);
                for(Map<String, Id> mapIterator : parentContractRecordTypeMatchingMapList){
                    if(mapIterator.containsKey(ContractEventConstants.REINSTATEMENT_EVENT_TYPE)){
                        billingItem.Parent_Billing_Item__c = mapIterator.get(ContractEventConstants.REINSTATEMENT_EVENT_TYPE);
                        parentBillingItemIdToUpdateBalanceOn = billingItem.Parent_Billing_Item__c;
                        break;
                    }
                } 
            }
            else if(contractEventInstallment.Event_Type__c == ContractEventConstants.EVENT_TYPE_RERATE_INSTALLMENT){
                parentContractRecordTypeMatchingMapList = contractIdToRecordTypeBillingItemMap.get(contractEventInstallment.Contract_Event__r.Contract__c);
                for(Map<String, Id> mapIterator : parentContractRecordTypeMatchingMapList){
                    if(mapIterator.containsKey(ContractEventConstants.RERATE_EVENT_TYPE)){
                        billingItem.Parent_Billing_Item__c = mapIterator.get(ContractEventConstants.RERATE_EVENT_TYPE);
                        parentBillingItemIdToUpdateBalanceOn = billingItem.Parent_Billing_Item__c;
                        break;
                    }
                }    
            }
            if(updateParentBillingItemMap.containsKey(parentBillingItemIdToUpdateBalanceOn) 
                && updateParentBillingItemMap.get(parentBillingItemIdToUpdateBalanceOn).Balance_Remaining__c != 0){
                updateParentBillingItemMap.get(parentBillingItemIdToUpdateBalanceOn).Balance_Remaining__c -= contractEventInstallment.Amount__c;
                updateParentBillingItemMap.put(parentBillingItemIdToUpdateBalanceOn, billingItemMap.get(parentBillingItemIdToUpdateBalanceOn));
            }
            else if(billingItemMap.get(parentBillingItemIdToUpdateBalanceOn).Balance_Remaining__c != 0 && billingItemMap.get(parentBillingItemIdToUpdateBalanceOn).Balance_Remaining__c != null){
                billingItemMap.get(parentBillingItemIdToUpdateBalanceOn).Balance_Remaining__c = billingItemMap.get(parentBillingItemIdToUpdateBalanceOn).Balance_Remaining__c - contractEventInstallment.Amount__c;
                updateParentBillingItemMap.put(parentBillingItemIdToUpdateBalanceOn, billingItemMap.get(parentBillingItemIdToUpdateBalanceOn));
            }
            billingItemList.add(billingItem);
        }

        try {
            updateParentBillingItemList.addAll(updateParentBillingItemMap.values());
            if(billingItemList != null && billingItemList.size() > 0) {
                billingItemList = billingItemDAOInstance.insertBillingItemList(billingItemList);
            }
            if(updateParentBillingItemList != null && updateParentBillingItemList.size() > 0){
                updateParentBillingItemList = billingItemDAOInstance.updateBillingItemList(updateParentBillingItemList);
            }
        } catch(Exception ex) {
            TWG_System_Error__c twgError = TWGSystemErrors.createTwgSystemError(TWGSystemErrors.Application.AUTOBP, null,
                BillingItemConstants.BILLING_ITEM_API_NAME, false, 
                ex, 'BillingItems', 'createBillingItemForNonFinancialContractEventInstallment');              
            insert twgError; //NOPMD
        }
    }

