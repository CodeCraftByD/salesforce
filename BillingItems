            BillingItemConstants.BILLING_ITEM_API_NAME);
        String statementType = BillingItemConstants.STATEMENT_TYPE_ITEM_BALANCE;
        Billing_Item__c billingItem = new Billing_Item__c();
        List<Account> enterpriseTrensferAccount = 
            accountDaoInstance.getTransferAccountByNumber(AccountConstants.ENTERPRISE_TRANSFER_ACCOUNT_NUMBER);
        if(enterpriseTrensferAccount.size() > 0) {
            billingItem.Client__c = enterpriseTrensferAccount[0].Id;
        }
        billingItem.RecordTypeId = recordType.Id;
        billingItem.Statement_Type__c = statementType;
        billingItem.Transfer_Contract__c  = contractEvent.Contract__c;
        if(contractEvent.Contract__r.Writing_Company_lookup__c != null) {
            billingItem.Writing_Company__c = contractEvent.Contract__r.Writing_Company_lookup__c;
        }
        if(contractEvent.ReasonType__c == ContractEventConstants.TRANSFER_REASON_TYPE) {
            billingItem.Accounting_Action__c = accountingActionDAOInstance.retrieveAccountingActionbyName(
                AccountingActionConstants.ACCOUNTING_ACTION_TA)[0].Id;
            notes = ContractEventConstants.TRANSFER_REASON_TYPE;
        } else if(contractEvent.ReasonType__c == ContractEventConstants.REVERSE_TRANSFER_REASON_TYPE) {
            billingItem.Accounting_Action__c = billingItem.Accounting_Action__c = accountingActionDAOInstance.retrieveAccountingActionbyName(
                AccountingActionConstants.ACCOUNTING_ACTION_TB)[0].Id;
            notes = ContractEventConstants.REVERSE_TRANSFER_REASON_TYPE;
        } 
        
        if(contractEvent.ReasonType__c == ContractEventConstants.REVERSE_TRANSFER_REASON_TYPE
          && contractEvent.Transfer_Fee__c > 0) {
              billingItem.Amount__c = (-1) * contractEvent.Transfer_Fee__c;
              billingItem.Balance_Remaining__c = (-1) * contractEvent.Transfer_Fee__c;
        } else {
            billingItem.Amount__c = contractEvent.Transfer_Fee__c;
            billingItem.Balance_Remaining__c = contractEvent.Transfer_Fee__c;   
        }
        
        notes += ' ' + contractEvent.Contract__r.Account_Name__r.AccountNumber + 
            ' ' + contractEvent.Contract__r.Customer_Name1__c;
        billingItem.Notes__c = notes;
        populateDummyIntegrationJobForUSBillingItems(billingItem);
        return billingItem;
    }
	
