    public List<Billing_Item__c> newMapReverseBillingItemsForBillingStatement (
        Billing_Statements__c billingStatement, Double reverseBillingAmount, Id recordTypeId, String statementType, 
        Account_Payment__c accountPayment, String parentAccountNumber, Map<Id, TWG_Product__c> mapOfTwgIDAndProduct,
        Boolean isBSPaid,  Map<String, Decimal> mapOfBSIdPerGLMappingToTotalAmount) {
        
        String glMappingType;
        Decimal initialAmount = 0.0;
        List<Billing_Item__c> listOfBillingItems = new List<Billing_Item__c>();
        Integer numberOfBillingItems = billingStatement.Billing_Items__r.size();
        String billingStatementName;
        billingStatementName = billingStatement.Name;
        Map<String,Decimal> mapGLMappingAndAmount = new Map<String,Decimal>();
        Integer billingItemCounter = 0;
        PaymentsAndDocuments paymentsAndDocumentsDomain = new PaymentsAndDocuments();
        String obligorCode;
        Map<String,String> mapGLMappingAndObligorCode = new Map<String,String>();
        while(billingItemCounter < numberOfBillingItems) {
            glMappingType = mapOfTwgIDAndProduct.get(billingStatement.Billing_Items__r[billingItemCounter].
            Contract_Event__r.Contract__r.Quote_Dealer_Product__r.Dealer_Product__r.TWG_Product__c).GL_Mapping_Type__c;

