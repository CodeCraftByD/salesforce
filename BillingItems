    public String setReconciliationTypeOnBillingItem(Account_Payment__c accountPayment, Billing_Item__c billingItem,
        String statementType, String parentAccountNumber, String dealerAccountNumber) {
            
        String createdDateStringFormat;
        String reconcileType;
        String transactionType;
        String bankReconciliationRef;
        String reconciliationRef;
        
        createdDateStringFormat = AccountPaymentManager.getDateInyyyymmddFormat(
            String.valueOf(date.today().Year()),
            '00' + String.valueOf(date.today().Month()),
            '00' + String.valueOf(date.today().Day()));
        
        reconcileType =
            BillingItemConstants.STATEMENT_TYPE_ACTIVITY_BALANCE.equalsIgnoreCase(statementType) ?
            AccountPaymentConstants.JOURNAL_LINE_CSHICO :
            BillingItemConstants.STATEMENT_TYPE_CONTRACT_REFUND.equalsIgnoreCase(statementType) ?
            AccountPaymentConstants.JOURNAL_LINE_CSHOCO :
            BillingItemConstants.STATEMENT_TYPE_CLAIM_PAYMENT.equalsIgnoreCase(statementType) ?
            AccountPaymentConstants.JOURNAL_LINE_CSHOCL :
            BillingItemConstants.STATEMENT_TYPE_COMMISSION.equalsIgnoreCase(statementType) ?
            (AccountPaymentConstants.PAYMENT_IN_OUT_INCOMING_STATUS.equalsIgnoreCase(
            accountPayment.Payment_In_Out__c) ?
            AccountPaymentConstants.JOURNAL_LINE_CSHIDC : AccountPaymentConstants.JOURNAL_LINE_CSHODC) : null;
            if(!String.isBlank(parentAccountNumber) && parentAccountNumber.length() > 13){
                parentAccountNumber = parentAccountNumber.subString(0,13)  ;
