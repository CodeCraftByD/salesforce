    public void netNegativeEscrowBillingItemsWithPositiveAmount(Map<String, List<Billing_Item__c>> negativeBillingItemMap, 
        Map<String, Decimal> positiveEscrowBalanceMap, List<Billing_Item__c> lstBillingItemToUpdate) {
        Decimal escrowBalanceRemaining;
        for(String accountId : negativeBillingItemMap.keySet()) {
            if(positiveEscrowBalanceMap.containsKey(accountId)) {
                for(Billing_Item__c negativeBillingItem : negativeBillingItemMap.get(accountId)) {
                    escrowBalanceRemaining = positiveEscrowBalanceMap.get(accountId);
                    if(escrowBalanceRemaining == 0) {
                        break;
                    }
                    if(escrowBalanceRemaining > 0 && (negativeBillingItem.Escrow_Balance_Remaining__c * -1) < escrowBalanceRemaining) {
                        escrowBalanceRemaining = negativeBillingItem.Escrow_Balance_Remaining__c + escrowBalanceRemaining;
                        negativeBillingItem.Escrow_Balance_Remaining__c = 0;
                    }
                    else if(escrowBalanceRemaining > 0 && (negativeBillingItem.Escrow_Balance_Remaining__c * -1) >= escrowBalanceRemaining) {
                        negativeBillingItem.Escrow_Balance_Remaining__c = negativeBillingItem.Escrow_Balance_Remaining__c + escrowBalanceRemaining;
                        escrowBalanceRemaining = 0;
                    }
                    positiveEscrowBalanceMap.put(accountId, escrowBalanceRemaining);
                    if(negativeBillingItem.Escrow_Balance_Remaining__c == 0) {
                        negativeBillingItem.Escrow_Funded_Date__c = Date.today();
                        negativeBillingItem.Escrow_Funded__c = true;
                    }
                    lstBillingItemToUpdate.add(negativeBillingItem);
                }
            }
        }
    }
    
    public void netPositiveEscrowBillingItemsWithNegativeAmount(Map<String, List<Billing_Item__c>> positiveBillingItemMap, 
        Map<String, Decimal> negativeEscrowBalanceMap, List<Billing_Item__c> lstBillingItemToUpdate) {
        Decimal escrowBalanceRemaining;
        for(String accountId : positiveBillingItemMap.keySet()) {
            if(negativeEscrowBalanceMap.containsKey(accountId)) {
                for(Billing_Item__c positiveBillingItem : positiveBillingItemMap.get(accountId)) {
                    escrowBalanceRemaining = negativeEscrowBalanceMap.get(accountId);
                    if(escrowBalanceRemaining == 0) {
                        break;
                    }
                    if((escrowBalanceRemaining * -1) > 0 && positiveBillingItem.Escrow_Balance_Remaining__c < (escrowBalanceRemaining * -1)) {
                        escrowBalanceRemaining = positiveBillingItem.Escrow_Balance_Remaining__c + escrowBalanceRemaining;
                        positiveBillingItem.Escrow_Balance_Remaining__c = 0;
                    }
                    else if((escrowBalanceRemaining * -1) > 0 && positiveBillingItem.Escrow_Balance_Remaining__c >= (escrowBalanceRemaining * -1)) {
                        positiveBillingItem.Escrow_Balance_Remaining__c = positiveBillingItem.Escrow_Balance_Remaining__c + escrowBalanceRemaining;
                        escrowBalanceRemaining = 0;
                    }
                    negativeEscrowBalanceMap.put(accountId, escrowBalanceRemaining);
                    if(positiveBillingItem.Escrow_Balance_Remaining__c == 0) {
                        positiveBillingItem.Escrow_Funded_Date__c = Date.today();
                        positiveBillingItem.Escrow_Funded__c = true;
                    }
