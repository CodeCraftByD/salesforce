    @TestVisible private List<Billing_Item__c> internalAdjustmentOfBillingItems(List<Billing_Item__c> listOfBillingItems, 
        Map<Id, Billing_Item__c> mapOfUpdatedOriginalBillingItems) {
        for (Billing_Item__c billingItem : listOfBillingItems) {
            if (mapOfUpdatedOriginalBillingItems.containsKey(billingItem.Id)) {
                billingItem = mapOfUpdatedOriginalBillingItems.get(billingItem.Id);
            }
            if (billingItem.Balance_Remaining__c < 0) {
                for (Billing_Item__c billingItemOpt : listOfBillingItems) {
                    if (mapOfUpdatedOriginalBillingItems.containsKey(billingItemOpt.Id)) {
                        billingItemOpt = mapOfUpdatedOriginalBillingItems.get(billingItemOpt.Id);
                    }
                    if (billingItem.Id != billingItemOpt.Id && billingItemOpt.Balance_Remaining__c > 0) {
                        if (Math.abs(billingItem.Balance_Remaining__c) < Math.abs(billingItemOpt.Balance_Remaining__c)) {
                            billingItemOpt.Balance_Remaining__c = 
                                billingItemOpt.Balance_Remaining__c + billingItem.Balance_Remaining__c;
                            billingItem.Balance_Remaining__c = 0;
                            mapOfUpdatedOriginalBillingItems.put(billingItem.Id, billingItem);
                            mapOfUpdatedOriginalBillingItems.put(billingItemOpt.Id, billingItemOpt);
                            break;
                        } else {
                            billingItem.Balance_Remaining__c = 
                                billingItem.Balance_Remaining__c + billingItemOpt.Balance_Remaining__c;
                            billingItemOpt.Balance_Remaining__c = 0;
                        }
                        mapOfUpdatedOriginalBillingItems.put(billingItem.Id, billingItem);
                        mapOfUpdatedOriginalBillingItems.put(billingItemOpt.Id, billingItemOpt);
                    }
                }
            }
        }
        return listOfBillingItems;
    }
	
