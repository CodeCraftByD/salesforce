    public List<Id> performNettingForPositiveBillingItems(List<Billing_Item__c> billingItemsList, 
        Map<Id, Double> billingItemsToBeNet) {
        Savepoint sp = Database.setSavepoint();
        Set<String> receiptClientBillingTypeSet = new Set<String>{AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_INSTALLMENT,
            AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_GROUP_INSTALLMENT};
        Set<Billing_Item__c> negativeBillingItemsList;
        Map<String, Set<String>> filterSetMap = getUniqueKeyMap(billingItemsList);
        Set<Id> clientSet = new Set<Id>();
        for(String clientKey : filterSetMap.get('clientKey')) {
            clientSet.add(Id.valueOf(clientKey));
        }
        if(receiptClientBillingTypeSet.contains(billingItemsList[0].Client__r.Billing_Type__c)){
            negativeBillingItemsList = 
                new Set<Billing_Item__c>(billingItemDAOInstance.getBillingItemsHaveNegativeBalanceRemainingByFilters(
                filterSetMap.get('salesInvoiceKey'), filterSetMap.get('contractKey'), filterSetMap.get('clientKey')));
        }
        else if((subscriptionDealer != null && billingItemsList[0].Client__r.AccountNumber == subscriptionDealer)
            || isTrackBalanceContractTypeDealer(billingItemsList[0])){
            negativeBillingItemsList = 
                new Set<Billing_Item__c>(
                billingItemDAOInstance.getNegativeBalanceRemainingBillingItemsByClient(clientSet));
        }
        else{
            negativeBillingItemsList = 
                new Set<Billing_Item__c>(billingItemDAOInstance.getBillingItemsHaveNegativeBalanceRemainingByGivenFilters(
                filterSetMap.get('salesInvoiceKey'), filterSetMap.get('writingCompanyKey'), filterSetMap.get('clientKey')));    
        }
        Map<String, Set<Billing_Item__c>> billingitembyuniquekeymap = new Map<String, Set<Billing_Item__c>>(); 
        for(Billing_Item__c billingItemObj : negativeBillingItemsList) {
            addInBillingItemsByUniqueKeyMap(billingItemObj, billingitembyuniquekeymap);
        }
        
        Map<String, Decimal> salesInvoiceNameMap = new Map<String, Decimal>();
        Map<Id, Billing_Item__c> billingItemsTobeUpdateMap = new Map<Id, Billing_Item__c>();
        List<Id> salesInvoiceToBeMatch = new List<Id>();
        for(Billing_Item__c positiveSalesInvoiceBillingItem : billingItemsList) {
            if(billingitembyuniquekeymap != null && billingitembyuniquekeymap.get(
                generateUniquKeyFromBillingItem(positiveSalesInvoiceBillingItem)) != null) {
                netSalesInvoiceBillingItems(positiveSalesInvoiceBillingItem, 
                    billingitembyuniquekeymap.get(generateUniquKeyFromBillingItem(positiveSalesInvoiceBillingItem)),
                salesInvoiceNameMap, billingItemsTobeUpdateMap, salesInvoiceToBeMatch);
            }
        }

        if(!salesInvoiceToBeMatch.isEmpty()) {
            try {
                billingItemDAONonStaticInstance.updateBillingItemList(billingItemsTobeUpdateMap.values());
                Boolean isPRNetting = false;
                for(Billing_Item__c positiveSalesInvoiceBillingItem : billingItemsList) {
                    if(positiveSalesInvoiceBillingItem.Client__c != null 
                       && positiveSalesInvoiceBillingItem.Client__c != null 
                       && positiveSalesInvoiceBillingItem.Client__r.Accounting_Company__c == TWG_Constants.FF_COMPANY_AIZ_PR_AUTO) 
                    {
                        isPRNetting = true;
                    }
                }
                if(isPRNetting) {
                    netSalesInvoicesPR(salesInvoiceToBeMatch, clientSet, salesInvoiceNameMap);
                } else {
                    netSalesInvoices(salesInvoiceToBeMatch, clientSet, salesInvoiceNameMap);
                }
            } catch(Exception e) {
                Database.rollback(sp);
                TWG_System_Error__c systemError = new TWG_System_Error__c (
                    Error_Message__c = e.getMessage() + salesInvoiceToBeMatch,
                    SFDC_Object_Name__c = TWGSystemErrorConstants.TWG_SYSTEM_ERROR_SFDC_OBJECT_NAME_BILLING_ITEM,
                    Username__c = UserInfo.getUserName(),
                    Stack_Trace__c = e.getStackTraceString()
                );
                insert systemError; //NOPMD
            }
        }
        return salesInvoiceToBeMatch;
    }
    
    public void netSalesInvoices(List<Id> salesInvoiceToBeMatch, Set<Id> clientSet, Map<String, Decimal> salesInvoiceNameMap) {
        List<Transaction__c> transactionList = null;
        if(!salesInvoiceToBeMatch.isEmpty()) {
            transactionList = transactionDAOInstance.getTransactionsForSalesInvoice(salesInvoiceToBeMatch);
            Map<Id, List<Transaction__c>> transactionsByAccountMap = new Map<Id, List<Transaction__c>>();
            for(Transaction__c transactionRecord : transactionList) {
                addTransactionIntoMap(transactionsByAccountMap, transactionRecord, transactionRecord.Account__c);
            }
            List<TWG_System_Error__c> systemErrorList = new List<TWG_System_Error__c>();
            List<Transaction_Matching_History__c> matchingHistoryList = new List<Transaction_Matching_History__c>();
            for(Id clientId : clientSet) {
                try { 
                    if(transactionsByAccountMap.get(clientId) != null && transactionsByAccountMap.get(clientId).size() > 0) {
                        List<Transaction__c> negativeTransactionList = new List<Transaction__c>();
                        List<Transaction__c> positiveTransactionList = new List<Transaction__c>();
                        for(Transaction__c transactionRecord : transactionsByAccountMap.get(clientId)) {
                            if(transactionRecord.Outstanding_Amount__c < 0) {
                                negativeTransactionList.add(transactionRecord);
                            } else if(transactionRecord.Outstanding_Amount__c > 0) {
                                positiveTransactionList.add(transactionRecord);
                            }
                        }
                        matchingHistoryList.addAll(TransactionMatchingHistories.createTransactionMatchingHistories(
                            negativeTransactionList, positiveTransactionList, salesInvoiceNameMap));
                    }
                } catch(Exception e) {
                    TWG_System_Error__c systemError = new TWG_System_Error__c(
                        Error_Message__c = e.getMessage() + salesInvoiceNameMap,
                        SFDC_Object_Name__c = TWGSystemErrorConstants.TWG_SYSTEM_ERROR_SFDC_OBJECT_NAME_BILLING_ITEM,
                        Username__c = UserInfo.getUserName(),
                        Stack_Trace__c = e.getStackTraceString()+' T '+transactionsByAccountMap.get(clientId) +
                        ' Client Id '+clientId);
                    systemErrorList.add(systemError);
                }
            }
            if(!matchingHistoryList.isEmpty()) {
                transactionMatchingHistoryDAOInstance.insertTransactionMatchingHistories(matchingHistoryList);
                SalesInvoices.updateSalesInvoiceWithTransaction(transactionList);
            }
            if(!systemErrorList.isEmpty()) {
                TWGSystemErrorDAO.insertErrorLogRecordWithAllDetails(systemErrorList);
            }
        }
    }

    public void netSalesInvoicesPR(List<Id> salesInvoiceToBeMatch, Set<Id> clientSet, Map<String, Decimal> salesInvoiceNameMap) {
        List<Transaction__c> transactionList = null;
        if(!salesInvoiceToBeMatch.isEmpty()) {
            transactionList = transactionDAOInstance.getTransactionsForSalesInvoice(salesInvoiceToBeMatch);
            Map<Id, List<Transaction__c>> transactionsByAccountMap = new Map<Id, List<Transaction__c>>();
            for(Transaction__c transactionRecord : transactionList) {
                addTransactionIntoMap(transactionsByAccountMap, transactionRecord, transactionRecord.Account__c);
            }

            List<TWG_System_Error__c> systemErrorList = new List<TWG_System_Error__c>();
            List<Transaction_Matching_History__c> matchingHistoryList = new List<Transaction_Matching_History__c>();
            for(Id clientId : clientSet) {
                try { 
                    if(transactionsByAccountMap.get(clientId) != null && transactionsByAccountMap.get(clientId).size() > 0) {
                        List<Transaction__c> negativeTransactionList = new List<Transaction__c>();
                        List<Transaction__c> positiveTransactionList = new List<Transaction__c>();
                        for(Transaction__c transactionRecord : transactionsByAccountMap.get(clientId)) {
                            if(transactionRecord.Outstanding_Amount__c < 0) {
                                negativeTransactionList.add(transactionRecord);
                            } else if(transactionRecord.Outstanding_Amount__c > 0) {
                                positiveTransactionList.add(transactionRecord);
                            }
                        }
                        matchingHistoryList.addAll(TransactionMatchingHistories.createTransactionMatchingHistories(
                            negativeTransactionList, positiveTransactionList, salesInvoiceNameMap));
                    }
                } catch(Exception e) {
                    TWG_System_Error__c systemError = new TWG_System_Error__c(
                        Error_Message__c = e.getMessage() + salesInvoiceNameMap,
                        SFDC_Object_Name__c = TWGSystemErrorConstants.TWG_SYSTEM_ERROR_SFDC_OBJECT_NAME_BILLING_ITEM,
                        Username__c = UserInfo.getUserName(),
                        Stack_Trace__c = e.getStackTraceString()+' T '+transactionsByAccountMap.get(clientId) +
                        ' Client Id '+clientId);
                    systemErrorList.add(systemError);
                }
            }
            if(!matchingHistoryList.isEmpty()) {
                transactionMatchingHistoryDAOInstance.insertTransactionMatchingHistories(matchingHistoryList);
                SalesInvoices.updateSalesInvoiceWithTransaction(transactionList);
            }

            if(!systemErrorList.isEmpty()) {
                TWGSystemErrorDAO.insertErrorLogRecordWithAllDetails(systemErrorList);
            }
        }
    }
    
