                                updateBillingItem = true;
                            }
                            if(billingItems.Total_Incentive_Client_Fee__c != null
                                && billingItems.Total_Incentive_Client_Fee__c != 0) {
                                if(groupingForUP) {
                                    if(writingCompanyForUltimateParentDIDO != '') {
                                        addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('B1B2'), 
                                            writingCompanyForUltimateParentDIDO,
                                            billingItems.Total_Incentive_Client_Fee__c.setScale(2), errorList);
                                    }
                                    else {
                                        addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('B1B2'), 
                                            writingCompany, billingItems.Total_Incentive_Client_Fee__c.setScale(2), errorList);
                                    }
                                    billingItems.DIDO_Created__c = true;
                                }
                                else if(!billingItems.Client__r.Ultimate_Parent__r.Group_Client_Fee__c) {
                                    addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('B1B2'), 
                                        writingCompany, billingItems.Total_Incentive_Client_Fee__c.setScale(2), errorList);
                                    billingItems.DIDO_Created__c = true;
                                }
                                updateBillingItem = true;
                            }
                            if(billingItems.Total_Training_Fee__c != null && billingItems.Total_Training_Fee__c != 0){
                                if(groupingForUP) {
                                    if(writingCompanyForUltimateParentDIDO != '') {
                                        addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('C1C2'), 
                                            writingCompanyForUltimateParentDIDO, billingItems.Total_Training_Fee__c.setScale(2),
                                            errorList);
                                    }
                                    else {
                                        addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('C1C2'), 
                                            writingCompany, billingItems.Total_Training_Fee__c.setScale(2), errorList);
                                    }
                                    billingItems.DIDO_Created__c = true;
                                }
                                else if(!billingItems.Client__r.Ultimate_Parent__r.Group_Client_Fee__c) {
                                    addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('C1C2'), 
                                        writingCompany, billingItems.Total_Training_Fee__c.setScale(2), errorList);
                                    billingItems.DIDO_Created__c = true;
                                }
                                updateBillingItem = true;
                            }
                            if(billingItems.isSet('Compensation_Amount__c') && billingItems.Compensation_Amount__c != null 
                                && billingItems.Compensation_Amount__c != 0){
                                addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('4O4I'), 
                                    writingCompany, billingItems.Compensation_Amount__c.setScale(2), errorList);
                                billingItems.DIDO_Created__c = true;
                                updateBillingItem = true;
                            }
                        }
                        if(updateBillingItem) {
                            if(billingItems.Writing_Company__c != billingItems.Client__r.Writing_Company__c) {
                                billingItems.WC_Updated__c = true;
                            }
                            billingItems.Writing_Company__c = billingItems.Client__r.Writing_Company__c;
                            if(billingItems.RD_Transaction__c!=null && accountingActionsToWritingCompanyChange.contains(
                                billingItems.RD_Transaction__r.Accounting_Action__r.Name)) {
                                billingItems.Writing_Company_Match__c = false;
                            }
                            else{
                                billingItems.Writing_Company_Match__c = true;
                            }
                            billingItemsToUpdateList.add(billingItems);
                        }
                    }
                }
            }
            if(errorList.size() > 0) {
                try {
                    insert errorList;
                } catch (Exception ex) {
                    TWG_System_Error__c twgError = TWGSystemErrors.createTwgSystemError(TWGSystemErrors.Application.AUTOBP, null,
                        'TWG_System_Error__c',false,ex.getMessage(),ex.getStackTraceString(),BillingItems.class.getName(),
                        'updateBillingItemsHavingOtherWritingCompanyForUSAuto');
                    TWGSystemErrorDAO.insertErrorLogRecordWithAllDetails(new List<TWG_System_Error__c>{twgError});
                }
            }
        }
        return billingItemsToUpdateList;
    }

    public static void createCashEntrySummaries(Map<Id, Cash_Entry_Summary__c> salesInvoiceCashEntryMap,
        Map<String, Decimal> salesInvoiceNameMap, Map<String, Id> salesInvoiceIdToCashEntryIdMap) {
        List<Cash_Entry_Summary__c> cashEntrySummaryListToUpdate = new List<Cash_Entry_Summary__c>();
        if(salesInvoiceCashEntryMap.size() > 0) {
            List<Cash_Entry_Summary__c> cashEntrySummaryList = CashEntrySummaries.insertCashEntrySummaryRecords(
                new List<Cash_Entry_Summary__c>{salesInvoiceCashEntryMap.values()});
            Integer index = 0;
            for(Cash_Entry_Summary__c cashEntrySummary : cashEntrySummaryList) {
                Decimal amount = salesInvoiceCashEntryMap.values().get(index).Received_Amount__c;
                if(salesInvoiceCashEntryMap.values().get(index).Cash_Transaction_Type__c ==
                    CashEntriesConstants.TRANSACTION_TYPE_RECEIPT) {
                    amount = amount * -1;
                }
                salesInvoiceNameMap.put(cashEntrySummary.Name, amount);
                index++;
                List<String> paymentModeSplitList = cashEntrySummary.Payment_Mode__c.split('-');
                salesInvoiceIdToCashEntryIdMap.put(paymentModeSplitList[1], cashEntrySummary.Id);
                cashEntrySummary.Payment_Mode__c = paymentModeSplitList[0];
                cashEntrySummaryListToUpdate.add(cashEntrySummary);
            }
        }
        if(cashEntrySummaryListToUpdate.size() > 0) {
            cashEntrySummaryDAOInstance.updateCashEntrySummaries(cashEntrySummaryListToUpdate);
        }
    }

