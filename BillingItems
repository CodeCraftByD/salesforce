    public static void validateIncorrectVAT(List<Billing_Item__c> billingItems) {
        Set<String> setOfBillingItemTypes= 
            new Set<String>{ BillingItemConstants.BILLING_3PI_DEALER_NEGATIVE,
            BillingItemConstants.BILLING_3PI_DEALER_POSITIVE,
            BillingItemConstants.BILLING_CHILD_NO_TAX_NEGATIVE,
            BillingItemConstants.BILLING_CHILD_NO_TAX_POSITIVE,
            BillingItemConstants.BILLING_CHILD_RISK_ITEMS_NEGATIVE,
            BillingItemConstants.BILLING_CHILD_RISK_ITEMS_POSITIVE,
            BillingItemConstants.BILLING_CHILD_VATABLE_ITEMS_NEGATIVE,
            BillingItemConstants.BILLING_CHILD_VATABLE_ITEMS_POSITIVE,
            BillingItemConstants.BILLING_ITEM_BILLING_CUSTOMER_NEGATIVE,
            BillingItemConstants.BILLING_ITEM_BILLING_CUSTOMER_POSITIVE,
            BillingItemConstants.BILLING_DEALER,
            BillingItemConstants.BILLING_DEALER_POSITIVE,
            BillingItemConstants.BILLING_DEALER_NEGATIVE };

        billingItems = billingItemDAOInstance.getBillingItemByBillingItemId(billingItems);
        List<Billing_Item__c> billingItemsWithIncorrectVAT = new List<Billing_Item__c>();
        Double dealerCommissionTax ;
        List<TWG_System_Error__c> systemErrorList = new List<TWG_System_Error__c>();

        for(Billing_Item__c billingItem: billingItems) {
            try {
                dealerCommissionTax = 0;
                if((billingItem.Contract_Event__r.Contract__r.RecordTypeId == ContractConstants.CONTRACT_EU_PPM_RECORD_TYPE_ID
                    || billingItem.Contract_Event__r.Contract__r.RecordTypeId == ContractConstants.CONTRACT_NON_PPM_EU_RECORD_TYPE_ID )
                    && (billingItem.Client__r !=null && billingItem.Client__r.Branding__r !=null && billingItem.Client__r.Branding__r.Manufacturer__c !=null
                    && billingItem.Client__r.Branding__r.Manufacturer__c.toLowerCase().contains(BrandingConstants.TEXT_HONDA.toLowerCase())) ) {
                    if( billingItem.Contract_Event__r.Contract__r.Quote_Dealer_Product__r.Dealer_Product__r.TWG_Product__r.Channel__c == TWGProductConstants.CHANNEL_NAME_INSURED ) {
                        dealerCommissionTax = billingItem.Contract_Event__r.Tax_Dealer_Comm__c;
                    }
                    if( billingItem.recordTypeId == BillingItemConstants.BILLING_ITEM_CONTRACT_RECORD_TYPE_ID
                        && setOfBillingItemTypes.contains(billingItem.Type__c) 
                        && (billingItem.Contract_Event__r.Tax_Rate_IP__c != null) && (billingItem.Amount_Without_Vat__c != null) 
                        && (math.abs(((100 * (billingItem.Total_Amount__c - dealerCommissionTax)) 
                        / (100+billingItem.Contract_Event__r.Tax_Rate_IP__c)) - billingItem.Amount_Without_Vat__c) > 0.01 )) {
                        billingItemsWithIncorrectVAT.add(billingItem);
                    }   
                }
            } catch (Exception e) {
                TWG_System_Error__c systemError = new TWG_System_Error__c (
                    Error_Message__c = e.getMessage(),
                    SFDC_Object_Name__c = TWGSystemErrorConstants.TWG_SYSTEM_ERROR_SFDC_OBJECT_NAME_BILLING_ITEM,
                    SFDC_Id__c = billingItem.Id, Username__c = UserInfo.getUserName(),
                    Stack_Trace__c = e.getStackTraceString()
                );
                systemErrorList.add(systemError);
            }   
        }

        if(!systemErrorList.isEmpty()) {
            TWGSystemErrorDAO.insertErrorLogRecordWithAllDetails(systemErrorList);
        }
        if(!billingItemsWithIncorrectVAT.isEmpty()){ 
            sendEmailForIncorrectVAT(billingItemsWithIncorrectVAT); 
        }
    }

    public static void sendEmailForIncorrectVAT(List<Billing_Item__c> billingItems) {
        List<Messaging.Email> messages = new List<Messaging.Email>();
        List<OrgWideEmailAddress> orgWideEmail = OrgWideEmailAddressDAO.getOrgWideEmailAddressBySetOfAddress(new Set<String>{'no-replyauto@assurant.com'});
        Email_Ids__c emailsIds = Email_Ids__c.getValues('IncorrectVATAlert');
        
        if(emailsIds == null || emailsIds.Emails__c == null) {
            return;
        }
        
        String[] toEmailAddress = emailsIds.Emails__c.split(';');
        
        for(Billing_Item__c billingItem: billingItems) {
           
            String capturedDate = billingItem.CreatedDate == null ? null:billingItem.CreatedDate.Date().Format() ;
            String subject = 'Incorrect VAT Amount - New Record Detected '
            +capturedDate+' '+billingItem.Contract_Event__r.Contract__r.Customer_Contract_Number__c ;
            String textEmailBody = 'New Record Detected for '+billingItem.Contract_Event__r.Contract__r.Billing_Country__c+' VAT is incorrect.<br>'
            +'Please review record '+ billingItem.Contract_Event__r.Contract__r.Customer_Contract_Number__c
            +' and notify Production Support if DCR is required to correct record.<br><br>'
            +'Following are the values to be reviewed for ' +billingItem.Name+'<br><br>'
            +'  Amount Without VAT: '+billingItem.Amount_Without_Vat__c+'<br>'
            +'  Tax Rate: '+billingItem.Contract_Event__r.Tax_Rate_IP__c+'<br>'
            +'  Total Amount: '+billingItem.Total_Amount__c;
            Messaging.SingleEmailMessage message = new Messaging.SingleEmailMessage();
            message.setToAddresses(toEmailAddress);
            message.setOrgWideEmailAddressId(orgWideEmail[0].Id);
            message.setSubject(Subject);
            message.setHtmlBody(textEmailBody); 
            messages.add(message);
        } 
        Messaging.sendEmail(messages);    
    }

