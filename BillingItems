    public static void createTOTIForCorporateGroup2CBillingItem(Map<Id, Billing_Item__c> newBillingItemsMap){
        Map<Id, Billing_Item__c> accountIdToBillingItemMap = new Map<Id,Billing_Item__c>();
        for(Billing_Item__c bI :billingItemDAOInstance.get2CBillingItemsForCorporateGroupAccountsByIds(newBillingItemsMap.keySet())){
            accountIdToBillingItemMap.put(bI.Client__c,bI);
        }
        if(!accountIdToBillingItemMap.isEmpty()){
            Set<Id> salesInvoiceIdset = new Set<Id>();
            Map<Id, List<Billing_Item__c>> salesInvoiceIdToBillingItemsMap = new Map<Id, List<Billing_Item__c>>();
            Map<String, Decimal> salesInvoiceNameMap = new Map<String, Decimal>();
            Map<Id, Sales_Invoice__c> salesInvoiceIdMap = new Map<Id, Sales_Invoice__c>();
            Integer indexTOTI = 0;
            Map<Integer, RD_Transaction__c> mapOfTO = new Map<Integer, RD_Transaction__c>();
            Map<Integer, RD_Transaction__c> mapOfTI = new Map<Integer, RD_Transaction__c>();
            Map<Id, Billing_Item__c> billingItemsToUpdateMap = new Map<Id, Billing_Item__c>();
            List<RD_Transaction__c> rdTransactionToInsertList = new List<RD_Transaction__c>();
            String companyName = FF_Company_Name__c.getInstance().NA_BP_Auto_Company_Name__c;
            Map<Id, Map<Id, Sales_Invoice__c>> parentAccounToChildAccountToPositiveSalesInvoiceMap =
                new Map<Id, Map<Id, Sales_Invoice__c>>();
            Map<Id, Map<Id, Sales_Invoice__c>> parentAccounToChildAccountToNegativeSalesInvoiceMap =
                new Map<Id, Map<Id, Sales_Invoice__c>>();
            Map<Id, Cash_Entry_Summary__c> salesInvoiceCashEntryMap = new Map<Id, Cash_Entry_Summary__c>();
            Set<String> billingTypeSet = new Set<String>{AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE,
                AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_GROUP};
            for(Sales_Invoice__c sI :salesInvoiceDAOInstance.getSalesInvoiceWithOutstandingValueByAccountIds(
                accountIdToBillingItemMap.keySet(), billingTypeSet)){
                if(sI.Outstanding_Amount__c > 0) {
                    if(sI.Account__r.Ultimate_Parent__c == null
                        && sI.Account__r.Billing_Type__c == AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_GROUP) {
                        if(!parentAccounToChildAccountToPositiveSalesInvoiceMap.containsKey(sI.Account__c)) {
                            parentAccounToChildAccountToPositiveSalesInvoiceMap.put(sI.Account__c,
                                new Map<Id, Sales_Invoice__c>());
                        }
                        parentAccounToChildAccountToPositiveSalesInvoiceMap.get(sI.Account__c).put(sI.Id, sI);
                    }else{
                        if(!parentAccounToChildAccountToPositiveSalesInvoiceMap.containsKey(sI.Account__r.Ultimate_Parent__c)) {
                            parentAccounToChildAccountToPositiveSalesInvoiceMap.put(sI.Account__r.Ultimate_Parent__c,
                                new Map<Id, Sales_Invoice__c>());
                        }
                        parentAccounToChildAccountToPositiveSalesInvoiceMap.get(sI.Account__r.Ultimate_Parent__c).put(sI.Id, sI);
                    }
                }
                if(sI.Outstanding_Amount__c < 0) {
                    if(sI.Account__r.Ultimate_Parent__c == null
                        && sI.Account__r.Billing_Type__c == AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_GROUP){
                        if(!parentAccounToChildAccountToNegativeSalesInvoiceMap.containsKey(sI.Account__c)){
                            parentAccounToChildAccountToNegativeSalesInvoiceMap.put(sI.Account__c,
                                new Map<Id, Sales_Invoice__c>());
                        }
                        parentAccounToChildAccountToNegativeSalesInvoiceMap.get(sI.Account__c).put(sI.Id, sI);
                    }else{
                        if(!parentAccounToChildAccountToNegativeSalesInvoiceMap.containsKey(sI.Account__r.Ultimate_Parent__c)) {
                            parentAccounToChildAccountToNegativeSalesInvoiceMap.put(sI.Account__r.Ultimate_Parent__c,
                                new Map<Id, Sales_Invoice__c>());
                        }
                        parentAccounToChildAccountToNegativeSalesInvoiceMap.get(sI.Account__r.Ultimate_Parent__c).put(sI.Id, sI);
                    }
                }
                salesInvoiceIdset.add(sI.Id);
            }
            if(!salesInvoiceIdset.isEmpty()){
                Set<Id> salesInvoiceIdsToUpdate = new Set<Id>();
                populateTOTIIds();
                for(Billing_Item__c item :billingItemDAOInstance.getBillingItemsBySalesInvoicesHaveNonZeroBalanceRemaining(salesInvoiceIdset)){
                    if(!salesInvoiceIdToBillingItemsMap.containsKey(item.Invoice__c)) {
                        salesInvoiceIdToBillingItemsMap.put(item.Invoice__c, new List<Billing_Item__c>());
                    }
                    salesInvoiceIdToBillingItemsMap.get(item.Invoice__c).add(item);
                }
                for(Id accountId :accountIdToBillingItemMap.keySet()){
                    Billing_Item__c item = accountIdToBillingItemMap.get(accountId);
                    Map<Id, Sales_Invoice__c> positiveSalesInvoiceMap = parentAccounToChildAccountToPositiveSalesInvoiceMap.get(
                        accountId);
                    Map<Id, Sales_Invoice__c> negativeSalesInvoiceMap = parentAccounToChildAccountToNegativeSalesInvoiceMap.get(
                        accountId);
                    if(positiveSalesInvoiceMap != null){
                        for(Id invoiceId :positiveSalesInvoiceMap.keySet()){
                            Sales_Invoice__c positiveSalesInvoice = positiveSalesInvoiceMap.get(invoiceId);
                            if(accountId != positiveSalesInvoice.Account__c) {
                                indexTOTI++;
                                mapTOTIRDTransactionsForPositiveSalesInvoice(rdTransactionToInsertList, mapOfTI, mapOfTO, 
                                    positiveSalesInvoice, item, indexTOTI);
                            }
                            createCashEntries(positiveSalesInvoice, salesInvoiceCashEntryMap, salesInvoiceNameMap,
                                positiveSalesInvoice.Outstanding_Amount__c, salesInvoiceIdMap);
                            updateBillingItemsByAmount(salesInvoiceIdToBillingItemsMap.get(invoiceId), 
                                - 1 * positiveSalesInvoice.Outstanding_Amount__c, billingItemsToUpdateMap);
                            item.Balance_Remaining__c = item.Balance_Remaining__c + positiveSalesInvoice.Outstanding_Amount__c;
                            salesInvoiceIdsToUpdate.add(positiveSalesInvoice.Id);
                        }
                    }
                    if(negativeSalesInvoiceMap != null){
                        for(Id invoiceId :negativeSalesInvoiceMap.keySet()){
                            if(item.Balance_Remaining__c == 0){
                                break;
                            }
                            Sales_Invoice__c negativeSalesInvoice = negativeSalesInvoiceMap.get(invoiceId);
                            Decimal invoiceAmt = Math.abs(negativeSalesInvoice.Outstanding_Amount__c);
                            if(invoiceAmt > Math.abs(item.Balance_Remaining__c)){
                                invoiceAmt = item.Balance_Remaining__c;
                            }
                            if(accountId != negativeSalesInvoice.Account__c) {
                                indexTOTI++;
                                mapTOTIRDTransactionsForNegativeSalesInvoice(rdTransactionToInsertList, mapOfTI, mapOfTO, 
                                negativeSalesInvoice, item, indexTOTI, invoiceAmt);
                            }
                            createCashEntries(negativeSalesInvoice, salesInvoiceCashEntryMap, salesInvoiceNameMap, invoiceAmt,
                                salesInvoiceIdMap);
                            updateBillingItemsByAmount(salesInvoiceIdToBillingItemsMap.get(invoiceId), invoiceAmt, billingItemsToUpdateMap);
                            item.Balance_Remaining__c = item.Balance_Remaining__c - invoiceAmt;
                            salesInvoiceIdsToUpdate.add(negativeSalesInvoice.Id);
                        }
                    }
                    item.Is_Netted_With_Corporate_Accounts__c = true;
                    billingItemsToUpdateMap.put(item.Id, item);
                }
                System.enqueueJob(new SalesInvoice2CNettingQueueableBatch(salesInvoiceCashEntryMap, salesInvoiceNameMap, companyName,
                    rdTransactionToInsertList, billingItemsToUpdateMap, mapOfTO, mapOfTI,salesInvoiceIdsToUpdate, salesInvoiceIdMap,0));
            }
        }
    }
    
