    public List<Billing_Item__c> performBillingItemAllocationForReversal(Map<Id,Map<Id,Decimal>> mapOfSalesInvoiceAllocationByWC,
        List<Billing_Item__c> billingItems, Boolean isDebitWriteoff) {
        Decimal toApply = 0;

        for (BIlling_Item__c billingItem : billingItems) {
            if(!mapOfSalesInvoiceAllocationByWC.containsKey(billingItem.Invoice__c)) {
                continue;
            }

            String useWC = null;
            if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null && mapOfSalesInvoiceAllocationByWC.get(
                billingItem.Invoice__c).containsKey(billingItem.Writing_Company__c)) {
                useWC = billingItem.Writing_Company__c;
            } else {
                continue;
            }

            If(!isDebitWriteoff && billingItem.Amount__c > billingItem.Balance_Remaining__c) {

                if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null &&
                    (billingItem.Amount__c - billingItem.Balance_Remaining__c) > mapOfSalesInvoiceAllocationByWC.get(
                    billingItem.Invoice__c).get(useWC)) {
                    if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null) {
                        billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c + mapOfSalesInvoiceAllocationByWC.get(
                            billingItem.Invoice__c).get(useWC);
                        toApply = mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).get(useWC);
                        mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).put(useWC,0.00);
                    }
                } else {
                    toApply = (billingItem.Amount__c - billingItem.Balance_Remaining__c);
                    if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null) {
                        mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).put(useWC,
                            mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).get(useWC) - (billingItem.Amount__c -
                            billingItem.Balance_Remaining__c));
                    }
                    billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c + (billingItem.Amount__c - billingItem.Balance_Remaining__c);
                }
            } else if(isDebitWriteoff && billingItem.Amount__c < billingItem.Balance_Remaining__c){
                Decimal absBalanceRemaining  = billingItem.Balance_Remaining__c.abs();
                Decimal absAmount  = billingItem.Amount__c.abs();
                if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null && (absAmount - absBalanceRemaining) >
                    mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).get(useWC)) {
                    if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null) {
                        billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c - mapOfSalesInvoiceAllocationByWC.get(
                            billingItem.Invoice__c).get(useWC);
                        toApply = mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).get(useWC);
                        mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).put(useWC,0.00);
                    }
                } else {
                    toApply = (billingItem.Amount__c - billingItem.Balance_Remaining__c);
                    if(mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c) != null) {
                        mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).put(useWC,
                            mapOfSalesInvoiceAllocationByWC.get(billingItem.Invoice__c).get(useWC) + (billingItem.Amount__c -
                            billingItem.Balance_Remaining__c));
                    }
                    billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c + (billingItem.Amount__c -
                        billingItem.Balance_Remaining__c);
                }
            }
        }

        return billingItems;
    }

