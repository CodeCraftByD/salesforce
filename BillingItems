    public List<Billing_Item__c> updateBillingItemsHavingOtherWritingCompanyGS(List<Billing_Item__c> billingItemsList, 
        Map<String,Double> writingCompanyAmountMap, Map<String, Map<String, Double>> writingCompanyAmountRDMap, 
        Boolean isForGoodSam){
        List<Billing_Item__c> billingItemsToUpdateList = new List<Billing_Item__c>();		
        String writingCompany = '';
        if(billingItemsList != null && !billingItemsList.isEmpty()){
            RecordType otherReceivablesRecordType = RecordTypeDAO.getRecordTypeByDeveloperNameAndObjectType
                (BillingItemConstants.OTHER_RECEIVABLES_RECORDTYPE, BillingItemConstants.BILLING_ITEM_API_NAME);
            US_Auto_Billing_Statement_Generation__c bsSetting = US_Auto_Billing_Statement_Generation__c.getInstance();
            US_Auto_Writing_Company_Change__c writingCompanyChangeSetting = US_Auto_Writing_Company_Change__c.getInstance();
            List<String> accountingActionsToCheckReceiptType = new List<String>();
            List<String> accountingActionsToCheckRDTypeList = new List<String>();
            List<String> paymentMethodsForPremiumInvoiceList = new List<String>();
            List<String> accActionsForReceiptTypeSIList = new List<String>();
            List<String> accountingActionsToWritingCompanyChange = new List<String>();
            
            if(bsSetting != null) {
                if(String.isNotEmpty(bsSetting.Accounting_Action_To_Check_Receipt_Type__c)) {
                    accountingActionsToCheckReceiptType = (List<String>)bsSetting.Accounting_Action_To_Check_Receipt_Type__c.split(',');
                }
                if(String.isNotEmpty(bsSetting.Accounting_Action_To_Check_RD_Type__c)) {
                    accountingActionsToCheckRDTypeList = (List<String>)bsSetting.Accounting_Action_To_Check_RD_Type__c.split(',');
                }
                Set<String> accountingActionsToCheckReceiptTypeSet = new Set<String>();
                if(accountingActionsToCheckReceiptType != null){
                    accountingActionsToCheckReceiptTypeSet.addAll(accountingActionsToCheckReceiptType);
                    accountingActionsToCheckReceiptTypeSet.removeAll(AccountingActionConstants.ACCOUNTING_ACTION_RD_TYPE_CHECK);
                    accountingActionsToCheckReceiptType.clear();
                    accountingActionsToCheckReceiptType.addAll(accountingActionsToCheckReceiptTypeSet);
                }
                if(accountingActionsToCheckRDTypeList != null){
                    accountingActionsToCheckRDTypeList.addAll(AccountingActionConstants.ACCOUNTING_ACTION_RD_TYPE_CHECK);
                }
                if(String.isNotEmpty(bsSetting.Payment_Methods_For_Premium_Invoice__c)) {
                    paymentMethodsForPremiumInvoiceList = (List<String>)bsSetting.Payment_Methods_For_Premium_Invoice__c.split(',');
                }
                if(String.isNotEmpty(bsSetting.Acc_Actions_for_Receipt_Type_SI_Stamping__c)) {
                    accActionsForReceiptTypeSIList = (List<String>)bsSetting.Acc_Actions_for_Receipt_Type_SI_Stamping__c.split(',');
                }
            }

            if(writingCompanyChangeSetting!=null){
                if(String.isNotEmpty(writingCompanyChangeSetting.Activity_To_Include_in_WCompany_Batch__c)){
                    accountingActionsToWritingCompanyChange = (List<String>)writingCompanyChangeSetting.Activity_To_Include_in_WCompany_Batch__c.split(',');
                }
            }

            List<TWG_System_Error__c> errorList = new List<TWG_System_Error__c>();
            Boolean updateBillingItem = false;
            Map<Id, Boolean> mapBIIDToMatchCompanyWriting = new Map<Id, Boolean>();
            for( Billing_Item__c getUpdatedBI : billingItemDAOInstance.getBillingItemByBillingItemId(billingItemsList) ){
                mapBIIDToMatchCompanyWriting.put( getUpdatedBI.Id, getUpdatedBI.Writing_Company_Match__c );
            }
            for(Billing_Item__c billingItems : billingItemsList){
                if(writingCompanyAmountRDMap != null) {
                    writingCompany = billingItems.Writing_Company__c + '__' + billingItems.Client__r.Writing_Company__c +
                        '__' + billingItems.Client__c+'__'+
                        SalesInvoices.getSalesInvoiceTypeByBillingItemForUSAuto(billingItems, otherReceivablesRecordType.Id, 
                        accountingActionsToCheckReceiptType, accountingActionsToCheckRDTypeList, paymentMethodsForPremiumInvoiceList,
                        accActionsForReceiptTypeSIList);
                    if(billingItems.Writing_Company__c != billingItems.Client__r.Writing_Company__c) {
                        updateBillingItem = false;
                        Decimal miscFee1Total = 
                            (billingItems?.Contract_Event__r?.Misc_Fee_1__c != null ? 
                            billingItems?.Contract_Event__r?.Misc_Fee_1__c : 0)
                            + (billingItems?.Contract_Event__r?.Reversal_Misc_Fee_1__c != null ? 
                            billingItems?.Contract_Event__r?.Reversal_Misc_Fee_1__c : 0);
                        if(billingItems.Amount__c <> 0) {
                            addWritingCompanyInWritingCompanyMap(writingCompanyAmountMap, writingCompany, 
                                billingItems.Amount__c.setScale(2), errorList);
                            updateBillingItem = true;
                        }
                        if(billingItems?.Contract_Event__r?.Current_Misc_Fee_1_Label__c == 
                            ClientFeeAllocationHeaderConstants.CONTRACT_EVENT_COMPENSATION_BUCKET
                            && miscFee1Total != null && miscFee1Total != 0) {
                            addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('4O4I'), 
                                writingCompany, miscFee1Total.setScale(2), errorList);
                            billingItems.DIDO_Created__c = true;
                            updateBillingItem = true;
                        } else if(billingItems.isSet('Compensation_Amount__c') 
                            && billingItems.Compensation_Amount__c != null && billingItems.Compensation_Amount__c != 0){
                            addWritingCompanyInWritingCompanyMap(writingCompanyAmountRDMap.get('4O4I'), 
                                writingCompany, billingItems.Compensation_Amount__c.setScale(2), errorList);
                            billingItems.DIDO_Created__c = true;
                            updateBillingItem = true;
                        }
                        if(updateBillingItem) {
                            if(billingItems.Writing_Company__c != billingItems.Client__r.Writing_Company__c) {
                                billingItems.WC_Updated__c = true;
                            }
                            billingItems.Writing_Company__c = billingItems.Client__r.Writing_Company__c;
                            if(billingItems.RD_Transaction__c!=null && accountingActionsToWritingCompanyChange.contains(
                                billingItems.RD_Transaction__r.Accounting_Action__r.Name)){
                                billingItems.Writing_Company_Match__c = false;
                            }
                            else{
                                billingItems.Writing_Company_Match__c = true;
                            }
                            billingItemsToUpdateList.add(billingItems);
                        }
                    }
                } else if( isForGoodSam 
                    && mapBIIDToMatchCompanyWriting.containsKey(billingItems.Id)
                    && (!mapBIIDToMatchCompanyWriting.get(billingItems.Id))
                    && billingItems.Writing_Company_Match__c == false
                ){
                    writingCompany = billingItems.Writing_Company__c + '__' + billingItems.Client__r.Writing_Company__c +
                        '__' + billingItems.Client__c+'__'+ SalesInvoices.getSalesInvoiceTypeByBillingItemForUSAuto(billingItems,
                        otherReceivablesRecordType.Id, accountingActionsToCheckReceiptType, accountingActionsToCheckRDTypeList,
                        paymentMethodsForPremiumInvoiceList, accActionsForReceiptTypeSIList);
                    if(billingItems.Writing_Company__c != billingItems.Client__r.Writing_Company__c && billingItems.Amount__c <> 0) {
                        try{
                            if(writingCompanyAmountMap.containsKey(writingCompany)){
                                writingCompanyAmountMap.put(writingCompany, writingCompanyAmountMap.get(writingCompany) + billingItems.Amount__c);
                            }else {
                                writingCompanyAmountMap.put(writingCompany, billingItems.Amount__c);
                            }
                            billingItems.Writing_Company__c = billingItems.Client__r.Writing_Company__c;
                            billingItems.Writing_Company_Match__c = true;
                            billingItemsToUpdateList.add(billingItems);
                        }
                        catch(Exception e) {
                            TWG_System_Error__c twgError = TWGSystemErrors.createTwgSystemError(TWGSystemErrors.Application.AUTOBP, null,
                                BillingItemConstants.BILLING_ITEM_API_NAME, true, e, BillingItems.class.getName(), 'updateBillingItemsHavingOtherWritingCompanyGS'); 
                            errorList.add(twgError);
                        }
                    }
                }
            }
            if(errorList.size() > 0) {
                twgSystemErrorDAOInstance.insertErrorLogRecordWithAllDetails(errorList);
            }
        }
        return billingItemsToUpdateList;
    }

    public static void createBillingItembyCasePayeeForCommissionPR(List<sObject> newObjList, Map<Id, sObject> oldObjMap) {
        List<Case_Payee__c> newCasePayeeList = (List<Case_Payee__c>) newObjList;
        List<Case_Payee__c> oldCasePayeeList = (List<Case_Payee__c>) oldObjMap.values();
        Map<Id, Case_Payee__c> oldCasePayeeMap = new Map<Id, Case_Payee__c> (oldCasePayeeList); 
        Set<Id> billingStatementIdsSet = new Set<Id>();
        Set<Id> accountIdsSet = new Set<Id>();
     
        Id otherReceivableBillingItemRecordTypeId = RecordTypeDAO.getRecordTypeId(BillingItemConstants.OTHER_RECEIVABLES_RECORDTYPE, 'Billing_Item__c');
        Id accoutingActionHT = accountingActionDAOInstance.retrieveAccountingActionbyName(AccountingActionConstants.ACCOUNTING_ACTION_HT)[0].Id;
        for(Case_Payee__c newCasePayee : newCasePayeeList) {
            if(newCasePayee.Status__c == CasePayeeConstants.CASE_PAYEE_PENDING_PAYMENT_STATUS
                && newCasePayee.Status__c != oldCasePayeeMap.get(newCasePayee.Id).Status__c
                && newCasePayee.Payment_Method__c == CasePayeeConstants.CASE_PAYEE_CHK_PAYMENT_METHOD) {
                billingStatementIdsSet.add(newCasePayee.Billing_Statement__c);
                accountIdsSet.add(newCasePayee.Account__c);
            }
        }

        Map<Id, Billing_Statements__c> billingStatementMapForCommissionPayment = new Map<Id, Billing_Statements__c>(
            billingStatementDAOInstance.getCommissionPaymentBillingStatementsByIds(billingStatementIdsSet));
        Map<Id, Account> accountMapForPR = accountDaoInstance.getAccountMapByIds(accountIdsSet);
        
        if(!accountMapForPR.isEmpty()) {
            List<Billing_Item__c> listOfBillingItems = new List<Billing_Item__c>();
            for (Case_Payee__c newCasePayee : newCasePayeeList) {
                if(accountMapForPR.get(newCasePayee.Account__c).Accounting_Company__c == AccountConstants.FF_COMPANY_AIZ_PR_AUTO
                    && accountMapForPR.get(newCasePayee.Account__c).Accounting_Company__c != null
                    && (((newCasePayee.Type__c == CasePayeeConstants.COMMISSION_PAYMENT_CASE_PAYEE_TYPE_LENDER_FEE ||
                            newCasePayee.Type__c == CasePayeeConstants.THIRD_PARTY_TYPE)
                        && newCasePayee.Income_Tax_Withheld__c > 0) 
                    || (newCasePayee.Type__c != CasePayeeConstants.COMMISSION_PAYMENT_CASE_PAYEE_TYPE_LENDER_FEE
                        && billingStatementMapForCommissionPayment.get(newCasePayee.Billing_Statement__c).Gross_Tax__c > 0))) { 
                    Billing_Item__c billingItem = new Billing_Item__c();
                    billingItem.Client__c = newCasePayee.Account__c;
                    billingItem.Case_Payee__c = newCasePayee.Id;
                    billingItem.Billing_Statement__c = newCasePayee.Billing_Statement__c;
                    if(newCasePayee.Type__c == CasePayeeConstants.COMMISSION_PAYMENT_CASE_PAYEE_TYPE_LENDER_FEE ||
                        newCasePayee.Type__c == CasePayeeConstants.THIRD_PARTY_TYPE) {
                        billingItem.Amount__c =  newCasePayee.Income_Tax_Withheld__c;
                    }else if(newCasePayee.Type__c != CasePayeeConstants.COMMISSION_PAYMENT_CASE_PAYEE_TYPE_LENDER_FEE){
                        billingItem.Amount__c = roundOffAmount(billingStatementMapForCommissionPayment.get(
                            newCasePayee.Billing_Statement__c).Gross_Tax__c);
                    }
                    billingItem.Balance_Remaining__c = 0;
                    billingItem.Statement_Type__c = BillingItemConstants.STATEMENT_TYPE_TAX_WITHHOLDING;
                    billingItem.Accounting_Action__c = accoutingActionHT;
                    billingItem.RecordTypeId = otherReceivableBillingItemRecordTypeId;
                    billingItem.Writing_Company__c = newCasePayee.Writing_Company__c;
                    populateDummyIntegrationJobForPRAIZBillingItems(billingItem);
                    listOfBillingItems.add(billingItem);
                }
            }
            if(!listOfBillingItems.isEmpty()) {
                try {
                    listOfBillingItems = billingItemDAOInstance.insertBillingItemList(listofBillingItems);
                }catch(Exception e) {
                    TWG_System_Error__c twgError = new TWG_System_Error__c();
                    twgError.Error_Message__c = e.getMessage();
                    twgError.SFDC_Object_Name__c = BillingItemConstants.BILLING_ITEM_API_NAME;
                    twgError.Stack_Trace__c = e.getStackTraceString();
                    twgSystemErrorDAOInstance.insertErrorLogRecordWithAllDetails(new List<TWG_System_Error__c>{twgError});
                }
            }
        }
