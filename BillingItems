    public static void addBillingItemInAppliedAmount(Map<Id,Map<String,Decimal>> listofAppliedAmounts, 
        Map<Id,Id> getClientIdbySalesInvoiceId, Decimal toApply, Billing_Item__c billingItem) {
        if (!listofAppliedAmounts.containsKey(billingItem.Invoice__c)) {
            if(billingItem.Invoice__c != null) {
                listofAppliedAmounts.put(billingItem.Invoice__c, new Map<String,Decimal>());
                getClientIdbySalesInvoiceId.put(billingItem.Invoice__c,billingItem.Client__c);
            }
        }

        if(listofAppliedAmounts.get(billingItem.Invoice__c) != null &&
            listofAppliedAmounts.get(billingItem.Invoice__c).containsKey(billingItem.Writing_Company__c)) {
            toApply = listofAppliedAmounts.get(billingItem.Invoice__c).get(billingItem.Writing_Company__c) + toApply;
        }

        if(listofAppliedAmounts.get(billingItem.Invoice__c) != null) {
            listofAppliedAmounts.get(billingItem.Invoice__c).put(billingItem.Writing_Company__c, toApply);
        }
    }

    @testVisible private Billing_Item__c mapCasePayeeToBillingItem(Id recordTypeId, Case_Payee__c payee) {
        Decimal paidAmount;
        String statementType,casePayeeAccount;

        if(payee.Payment_Method__c == CasePayeeConstants.NET_PAYMENT_METHOD) {
            paidAmount =  payee.FIN_Total_Paid_Amount__c * (-1);
            statementType = BillingItemConstants.STATEMENT_TYPE_ITEM_BALANCE;
        } else if (payee.Case__r.RecordType.DeveloperName == CaseConstants.CASE_UK_RECORD_TYPE_DEVELOPER_NAME) {
            paidAmount =  payee.FIN_Total_Authorized_Amount__c;
            statementType = BillingItemConstants.STATEMENT_TYPE_PAYABLE;
        } else {
            paidAmount =  payee.FIN_Total_Paid_Amount__c;
            statementType = BillingItemConstants.STATEMENT_TYPE_PAYABLE;
        }

        if (payee.Out_Of_Network__c) {
            
            if (!Trigger.isExecuting) {
                statementType = BillingItemConstants.STATEMENT_TYPE_PAYABLE;
                casePayeeAccount = payee.Account__c;
            } else {
                statementType = BillingItemConstants.STATEMENT_TYPE_ITEM_BALANCE;
                casePayeeAccount = payee.case__r.Contract_New__r.Account_Name__c;
            }

            if (paidAmount < 0) {
                paidAmount = paidAmount * (-1);
            }
        }
        else {
            casePayeeAccount = payee.Account__c;
        }

        Billing_Item__c item = new Billing_Item__c();
        item.recordTypeId = recordTypeId;
        item.Case_Payee__c = payee.Id;
        item.Amount__c = paidAmount;
        if(statementType == BillingItemConstants.STATEMENT_TYPE_ITEM_BALANCE) {
            item.Balance_Remaining__c = paidAmount;
        } else {
            item.Balance_Remaining__c = 0;
        }
        item.Client__c = casePayeeAccount;
        if (payee.Case__r.RecordType.DeveloperName != CaseConstants.CASE_UK_RECORD_TYPE_DEVELOPER_NAME) {
            item.Writing_Company__c = payee.case__r.Contract_New__r.Writing_Company_lookup__c;
        }
        item.Statement_Type__c = statementType;
        return item;
    }

    public List<TWG_System_Error__c> createErrorLogRecord(List<Billing_Item__c> billingItemErrorList,List<Database.SaveResult> resultList) {

        List<TWG_System_Error__c> systemErrorList = new List<TWG_System_Error__c>();

        for(Integer errorCount=0; errorCount<resultList.size(); errorCount++) {
            if (!resultList[errorCount].isSuccess()) {
                systemErrorList.add(mapErrorLog(billingItemErrorList[errorCount],resultList[errorCount].getErrors()[0]));
            }
        }
        return systemErrorList;
    }

    private TWG_System_Error__c mapErrorLog(Billing_Item__c item, Database.Error result) {

        TWG_System_Error__c systemError = new TWG_System_Error__c();
        systemError.SFDC_Id__c = item.Case_Payee__c;
        systemError.SFDC_Object_Name__c = 'Case_Payee__c';
        systemError.Error_Message__c = result.getMessage();
        systemError.Username__c = UserInfo.getUserName();

        return systemError;
    }

    public List<Billing_Item__c> createBillingItemsPerWriteOffUpToMaxAmount(
        Id salesInvoiceID, Map<Id, List<RD_Transaction__c>> mapOfRDTransactionsGroupedBySINID,
        Map<Id,Map<String,Decimal>> mapOfSalesInvoiceAllocationsByWCApplied
    ) {

        RecordType rdTransactionRecordType = RecordTypeDAO.getRecordType('RD_Transaction','Billing_Item__c');
        List<Billing_Item__c> listOfRDBillingItems = new List<Billing_Item__c>();

        for (RD_Transaction__c rdTransaction : mapOfRDTransactionsGroupedBySINID.get(salesInvoiceID)) {
            Decimal rdTransactionAmount = rdTransaction.Amount__c;

            for (String writingCompanyID : mapOfSalesInvoiceAllocationsByWCApplied.get(salesInvoiceID).keySet()) {
                Decimal applyAmount = 0;

                if (rdTransactionAmount >= mapOfSalesInvoiceAllocationsByWCApplied.get(salesInvoiceID).get(writingCompanyID)) {
                    applyAmount = mapOfSalesInvoiceAllocationsByWCApplied.get(salesInvoiceID).get(writingCompanyID);
                    rdTransactionAmount = rdTransactionAmount - mapOfSalesInvoiceAllocationsByWCApplied.get(salesInvoiceID).get(writingCompanyID);
                    mapOfSalesInvoiceAllocationsByWCApplied.get(salesInvoiceID).remove(writingCompanyID);
                } else {
                    applyAmount = rdTransactionAmount;
                    mapOfSalesInvoiceAllocationsByWCApplied.get(
                        salesInvoiceID).put(writingCompanyID,
                        mapOfSalesInvoiceAllocationsByWCApplied.get(salesInvoiceID).get(writingCompanyID) - rdTransactionAmount
                    );
                    rdTransactionAmount = 0;
                }

                Billing_Item__c billingItem = mapRDTransactionToBillingItem(
                    rdTransactionRecordType.Id, rdTransaction, FALSE, writingCompanyID, applyAmount, FALSE
                );
                listOfRDBillingItems.add(billingItem);

                if (rdTransactionAmount == 0) {
                    break;
                }

            }

        }

        return listOfRDBillingItems;
    }

    public Billing_Item__c mapRDTransactionToBillingItem(Id recordTypeId, RD_Transaction__c tran, Boolean useAssociatedFields,
                                                         Id writingCompany, Decimal amount, Boolean useFullAmount) {

        if (tran == null || recordTypeId == null) {
            return null;
        }

        Boolean isEscrow = AccountingActionConstants.ACCOUNTING_ACTIONS_ESCROW.contains(tran.Accounting_Action__r.Name);
        Billing_Item__c item = new Billing_Item__c();
        item.recordTypeId = recordTypeId; 
        item.RD_Transaction__c = tran.Id; 
        item.Statement_Type__c = mapStatementType(tran.Accounting_Action__r.Client_Billable__c,
            tran.Accounting_Action__r.Client_Fee_Billable__c,tran.Accounting_Action__r.Client_Activity__c, isEscrow);
        
        if(tran.Case_Payee__c != null){
            item.Case_Payee__c = tran.Case_Payee__r.Id;
        }
        
        if (useAssociatedFields != null && useAssociatedFields == true) {
            item.Client__c = tran.Associated_Client__c;
            item.Writing_Company__c = tran.Transfer_To_From__c;
            item.Amount__c = mapTransactionAmountForAssociatedAcccount(tran.Accounting_Action__r.Debit_Credit_Code__c,tran.Amount__c);
        } else {
            if(tran.Accounting_Action__r.name != AccountingActionConstants.ACCOUNTING_ACTION_1C){
                item.Client__c = tran.Client__c;
            }
            item.Writing_Company__c = tran.Writing_Company__c;
            if(tran.Amount__c != null) {
                if(tran.Accounting_Action__r.IsClientFeeAccountingActionCode__c || tran.Accounting_Action__r.Reverse_D_C_on_BI__c){
