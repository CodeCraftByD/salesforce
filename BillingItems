    public static List<Billing_Item__c> createReverseBillingItems(Set<Id> casePayeeIdSetForBillingItemReversal) {
        List<Billing_Item__c> reverseBillingItemsListToInsert = new List<Billing_Item__c>();
        Map<Id, List<Billing_Item__c>> billingItemByCasePayeeId = new Map<Id, List<Billing_Item__c>>();
        List<Billing_Item__c> billingItemsToReverse = new List<Billing_Item__c>();
        Integer queryCounter = 0;
        for (Billing_Item__c billingItem : billingItemDAOInstance.getPayableAndReceivableBillingItemsWithNettedClaimByCasePayeeIds(
            casePayeeIdSetForBillingItemReversal)){
            queryCounter++;
            billingItemsToReverse = new List<Billing_Item__c>();
            if(billingItem.Case_Payee__r.Out_Of_Network__c){
                if(billingItemByCasePayeeId.containsKey(billingItem.Case_Payee__c)){
                    billingItemsToReverse = billingItemByCasePayeeId.get(billingItem.Case_Payee__c);
                    if(billingItemsToReverse.size() <= 1){
                        billingItemsToReverse.add(billingItem);
                        billingItemByCasePayeeId.put(billingItem.Case_Payee__c, billingItemsToReverse);
                    }
                } else {
                    billingItemsToReverse.add(billingItem);
                    billingItemByCasePayeeId.put(billingItem.Case_Payee__c, billingItemsToReverse);
                }
            } else {
                billingItemsToReverse.add(billingItem);
                if(!billingItemByCasePayeeId.containsKey(billingItem.Case_Payee__c)){
                    billingItemByCasePayeeId.put(billingItem.Case_Payee__c, billingItemsToReverse);
                }
            }
        }
        if(queryCounter == 0){
            for(Case_payee__c casePayee : CasePayeeDAOInstance.getNettedClaimCasePayeesBySetOfIds(casePayeeIdSetForBillingItemReversal)){
                reverseBillingItemsListToInsert.add(createReverseBillingItemsForVoidNetCasePayees(casePayee));
            }
        }
        billingItemsToReverse = new List<Billing_Item__c>();
        for (List<Billing_Item__c> billingItems : billingItemByCasePayeeId.values()){
            billingItemsToReverse.addAll(billingItems);
        }
        for (Billing_Item__c billingItemToReverse : billingItemsToReverse) {
            Billing_Item__c reverseBillingItem = billingItemToReverse.clone(false, true, false, false);
            reverseBillingItem.Amount__c = -billingItemToReverse.Amount__c;
            reverseBillingItem.Invoice__c = null;
            reverseBillingItem.Balance_Remaining__c = -billingItemToReverse.Amount__c;
            reverseBillingItem.Statement_Type__c = BillingItemConstants.STATEMENT_TYPE_ITEM_BALANCE;
            reverseBillingItemsListToInsert.add(reverseBillingItem);
        }
        return reverseBillingItemsListToInsert;
    }

