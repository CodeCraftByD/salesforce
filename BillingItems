            if(newBillingItem.Client__c != null) {
                clientIds.add(newBillingItem.Client__c);
            }
            if(newBillingItem.Writing_Company__c != null) {
                writingCompanyIds.add(newBillingItem.Writing_Company__c);
            }
        }
        Map<Id, Account> writingCompanyMap = accountDaoInstance.getAccountMapByIds(writingCompanyIds);
        Map<Id, Account> accountMap = accountDaoInstance.getFSWNAAutoAccountMapByAccountIdSet(clientIds);
        billingItemDAOInstance.getBillingItemByBillingItemId(billingItemsList);
        for(Billing_Item__c newBillingItem : billingItemsList) {
            if(newBillingItem.Writing_Company__c  != null &&  accountMap.containsKey(newBillingItem.Client__c)
                && writingCompanyMap.containsKey(newBillingItem.Writing_Company__c)) {
                Account  accountObj = accountMap.get(newBillingItem.Client__c);
                Account writingCompany = writingCompanyMap.get(newBillingItem.Writing_Company__c);
                if(String.isNotBlank(accountObj.Writing_Company__c)
