         +'    AND Statement_Type__c = '+ CalculateBillingItemsTotalsBatch.STATEMENT_TYPE_ITEM_BALANCE
         +'    AND Contract_Event__r.RecordTypeId IN '+CalculateBillingItemsTotalsBatch.CONTRACT_RECORDTYPE_SET_CORPORATE
