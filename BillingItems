                                     RDTransactionConstants.RD_TRANSACTION_RECORD_TYPE_MEX).getRecordTypeId();
        Boolean isMexicoInstance = true;
        for(RD_Transaction__c rdTransaction : listOfRDTransaction){
            if(rdTransaction.RecordTypeId != mexicoRDTransaction) {
                isMexicoInstance = false;
                break;
            }
