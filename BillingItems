    public List<Billing_Item__c> updateExistingBillingItemsForTFR(
        Map<String, Map<Id, Decimal>> mapOfBillingAndPaymentStatementWithAmount, Account_Payment__c accountPayment, String parentAccountNumber) {

        Map<Id, Decimal> mapOfSalesInvoiceIdWithAmount = mapOfBillingAndPaymentStatementWithAmount.get('BillingStatement');
        Map<Id, Decimal> mapOfPayableInvoiceIdWithAmount = mapOfBillingAndPaymentStatementWithAmount.get('PaymentStatement');
        Map<Id, List<Billing_Item__c>> mapOfBillingItemsWithSalesInvoiceIds = new Map<Id, List<Billing_Item__c>>();
        Map<Id, List<Billing_Item__c>> mapOfBillingItemsWithPayableInvoiceIds = new Map<Id, List<Billing_Item__c>>();
        List<Billing_Item__c> listOfBillingItemForUpdateOrInsert = new List<Billing_Item__c>(); 
        List<Billing_Item__c>  listOfBillingItemsOfBS = new List<Billing_Item__c>();
        List<Billing_Item__c>  listOfBillingItemsOfPS = new List<Billing_Item__c>();
        if (mapOfSalesInvoiceIdWithAmount != null && mapOfSalesInvoiceIdWithAmount.keySet().size() > 0) {
            listOfBillingItemsOfBS = billingItemDAOInstance.getBillingItemsByBillingStatementsAndOrderByCreatedDate(mapOfSalesInvoiceIdWithAmount.keySet());
        }
        if (mapOfPayableInvoiceIdWithAmount != null && mapOfPayableInvoiceIdWithAmount.keySet().size() > 0) {
            listOfBillingItemsOfPS = billingItemDAOInstance.getBillingItemsByPaymentStatementsAndOrderByCreatedDate(mapOfPayableInvoiceIdWithAmount.keySet());
        }                
        Map<Id, Billing_Item__c> mapOfUpdatedOriginalBillingItems = new Map<Id, Billing_Item__c>();
        for(Billing_Item__c billingItem : listOfBillingItemsOfPS) {
            if (!mapOfBillingItemsWithPayableInvoiceIds.containsKey(billingItem.Payment_Statement__c)) {
                mapOfBillingItemsWithPayableInvoiceIds.put(billingItem.Payment_Statement__c, new List<Billing_Item__c>());
            }
            mapOfBillingItemsWithPayableInvoiceIds.get(billingItem.Payment_Statement__c).add(billingItem);
        }

        if(listOfBillingItemsOfBS.size() + listOfBillingItemsOfPS.size() > 500){
            if(mapOfPayableInvoiceIdWithAmount != null){
                mapOfSalesInvoiceIdWithAmount.putAll(mapOfPayableInvoiceIdWithAmount);
            }    
            Database.executeBatch(new BIUpdatationForProceesedAPBatch(accountPayment, mapOfSalesInvoiceIdWithAmount));
            return createAndUpdateExistingBillingItemsForPS(mapOfPayableInvoiceIdWithAmount,accountPayment, mapOfBillingItemsWithPayableInvoiceIds, mapOfUpdatedOriginalBillingItems, parentAccountNumber);
        }

        for(Billing_Item__c billingItem : listOfBillingItemsOfBS) {
            if (!mapOfBillingItemsWithSalesInvoiceIds.containsKey(billingItem.Billing_Statement__c)) {
                mapOfBillingItemsWithSalesInvoiceIds.put(billingItem.Billing_Statement__c, new List<Billing_Item__c>());
            }
            mapOfBillingItemsWithSalesInvoiceIds.get(billingItem.Billing_Statement__c).add(billingItem);
        }
        
        for (Id billingStatementId : mapOfBillingItemsWithSalesInvoiceIds.keySet()) {
            List<Billing_Item__c>  listOfBillingItems = mapOfBillingItemsWithSalesInvoiceIds.get(billingStatementId);
            internalAdjustmentOfBillingItems(listOfBillingItems, mapOfUpdatedOriginalBillingItems);
            Decimal allocatedAmount = mapOfSalesInvoiceIdWithAmount.get(billingStatementId);
            for (Billing_Item__c billingItem : listOfBillingItems) {
                if (mapOfUpdatedOriginalBillingItems.containsKey(billingItem.Id)) {
                    billingItem = mapOfUpdatedOriginalBillingItems.get(billingItem.Id);
                }
                if (Math.abs(billingItem.Balance_Remaining__c) > Math.abs(allocatedAmount)) {
                    billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c - allocatedAmount;
                    allocatedAmount = 0;
                    mapOfUpdatedOriginalBillingItems.put(billingItem.Id, billingItem);
                    break;
                } else {
                    Decimal remainingBalance = billingItem.Balance_Remaining__c;
                    billingItem.Balance_Remaining__c = 0;
                    allocatedAmount = allocatedAmount - remainingBalance;
                }
                mapOfUpdatedOriginalBillingItems.put(billingItem.Id, billingItem);
            }
        }
        listOfBillingItemForUpdateOrInsert = createAndUpdateExistingBillingItemsForPS(mapOfPayableInvoiceIdWithAmount, accountPayment, mapOfBillingItemsWithPayableInvoiceIds, mapOfUpdatedOriginalBillingItems, parentAccountNumber);
        if (!mapOfUpdatedOriginalBillingItems.isEmpty() && !mapOfUpdatedOriginalBillingItems.values().isEmpty()) {
            listOfBillingItemForUpdateOrInsert.addAll(mapOfUpdatedOriginalBillingItems.values());
        }
        return listOfBillingItemForUpdateOrInsert;
    }

    public List<Billing_Item__c> createAndUpdateExistingBillingItemsForPS(Map<Id, Decimal> mapOfPayableInvoiceIdWithAmount, Account_Payment__c accountPayment, Map<Id, List<Billing_Item__c>> mapOfBillingItemsWithPayableInvoiceIds, Map<Id, Billing_Item__c> mapOfUpdatedOriginalBillingItems, String parentAccountNumber){
        List<Id> listOfCasePayeeIdsToBeUpdated = new List<Id>();
        List<Billing_Item__c> listOfBillingItemForUpdateOrInsert = new List<Billing_Item__c>();
        Id recordTypeIdForOutgoingPaymentBI = RecordTypeDAO.getRecordType('Outgoing_Payment', 'Billing_Item__c').Id;

        Map<Id,Payment_Statement__c> mapofPaymentStatementAndId = new Map<Id,Payment_Statement__c>(
            paymentStatementDAOInstance.getPaymentStatementsByIDSet(mapOfBillingItemsWithPayableInvoiceIds.keySet()));

        for (Id paymentStatementId : mapOfBillingItemsWithPayableInvoiceIds.keySet()) {
            List<Billing_Item__c>  listOfBillingItems = mapOfBillingItemsWithPayableInvoiceIds.get(paymentStatementId);
            Billing_Item__c newBillingItemRecord;
            Decimal allocatedAmount = mapOfPayableInvoiceIdWithAmount.get(paymentStatementId);
            Decimal allocatedAmountPresent = allocatedAmount / mapofPaymentStatementAndId.get(paymentStatementId).Invoice_Total__c;
            internalAdjustmentOfBillingItems(listOfBillingItems, mapOfUpdatedOriginalBillingItems);
            for (Billing_Item__c billingItem : listOfBillingItems) {
                String paymentMethod = billingItem.Case_Payee__r.Case__r.Contract_New__r.Payment_method_s__c != null ? 
                    billingItem.Case_Payee__r.Case__r.Contract_New__r.Payment_method_s__c : null;
                Decimal newBIAmount = allocatedAmountPresent * billingItem.Amount__c;
                newBillingItemRecord = mapReverseBillingItemsForPaymentStatement(Math.abs(newBIAmount),
                    recordTypeIdForOutgoingPaymentBI, BillingItemConstants.STATEMENT_TYPE_CLAIM_PAYMENT,
                    billingItem.GL_Mapping_Type__c, billingItem.AIM_Client_Code__c, accountPayment, parentAccountNumber);
                newBillingItemRecord.Case_Payee__c = billingItem.Case_Payee__c;
                newBillingItemRecord.Obligor_Code__c = billingItem.Case_Payee__r.Case__r.Contract_New__r.Obligor_Code__c;
                newBillingItemRecord.Client__c = billingItem.Case_Payee__r.Case__r.Contract_New__r.Account_Name__c;
                if(paymentMethod != null && ContractConstants.SINGLEPREMIUM_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                    newBillingItemRecord.GL_Payment_Code__c = BillingItemConstants.SINGLE_PREMIUM_GL_PAYMENT_CODE;
                }
                if(paymentMethod != null && ContractConstants.THIRD_PARTY_INSTALLMENT_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                    newBillingItemRecord.GL_Payment_Code__c = BillingItemConstants.THIRD_PARTY_INSTALLMENT_GL_PAYMENT_CODE;
                }
                if(paymentMethod != null && ContractConstants.CUSTOMERDD_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                    newBillingItemRecord.GL_Payment_Code__c = BillingItemConstants.CUSTOMER_DD_GL_PAYMENT_CODE;
                }
                if(paymentMethod != null && ContractConstants.THIRDPARTYDD_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                    newBillingItemRecord.GL_Payment_Code__c = BillingItemConstants.THIRD_PARTY_DD_GL_PAYMENT_CODE;
                }
                if(paymentMethod != null && ContractConstants.CARD_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                    newBillingItemRecord.GL_Payment_Code__c = BillingItemConstants.CARD_GL_PAYMENT_CODE;
                }
                if(paymentMethod != null && ContractConstants.MONTHLY_PAY_3RD_PARTY_PAYMENTMETHOD.equalsIgnoreCase(paymentMethod)) {
                    newBillingItemRecord.GL_Payment_Code__c = BillingItemConstants.MONTHLY_PAY_3RD_PARTY_GL_PAYMENT_CODE;
                }
                if(billingItem.Amount_Without_Vat__c != null && billingItem.Amount__c != null &&  billingItem.Amount__c != 0 ) {
                    newBillingItemRecord.Amount_Without_Vat__c = ((billingItem.Amount_Without_Vat__c / billingItem.Amount__c) *
                        (Math.abs(newBIAmount))).setScale(2);
                } else {
                    newBillingItemRecord.Amount_Without_Vat__c = 0;
                }
                listOfBillingItemForUpdateOrInsert.add(newBillingItemRecord);
                if(allocatedAmount>0) {
                    if (mapOfUpdatedOriginalBillingItems.containsKey(billingItem.Id)) {
                       billingItem = mapOfUpdatedOriginalBillingItems.get(billingItem.Id);
                    }
                    if (Math.abs(billingItem.Balance_Remaining__c) > Math.abs(allocatedAmount)) {
                        billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c - allocatedAmount;
                        allocatedAmount = 0;
                        mapOfUpdatedOriginalBillingItems.put(billingItem.Id, billingItem);
                    } else {
                        Decimal remainingBalance = billingItem.Balance_Remaining__c;
                        billingItem.Balance_Remaining__c = 0;
                        allocatedAmount = allocatedAmount - remainingBalance;
                        listOfCasePayeeIdsToBeUpdated.add(billingItem.Case_Payee__c);
                    }
                    mapOfUpdatedOriginalBillingItems.put(billingItem.Id, billingItem);
                }
            }
        }
        new CasePayees().updateCasePayeeToPaidStatus (listOfCasePayeeIdsToBeUpdated);
        return listOfBillingItemForUpdateOrInsert;
    }
    
    public String generateUniquKeyFromBillingItem(Billing_Item__c billingItem) {
        Set<String> receiptClientBillingTypeSet = new Set<String>{AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_INSTALLMENT,
            AccountConstants.ACCOUNT_BILLING_TYPE_CORPORATE_GROUP_INSTALLMENT};
        Boolean isInstallment = false;
        isInstallment = billingItem.Installment_Event__c != null ? true : false;

        if(receiptClientBillingTypeSet.contains(billingItem.Client__r.Billing_Type__c)){
            if(isInstallment){
                return billingItem.Invoice__r.Type__c+'_'+billingItem.Installment_Event__r.Contract_Event__r.Contract__c
                +'_'+billingItem.Client__c;
            }
            return billingItem.Invoice__r.Type__c+'_'+billingItem.Contract_Event__r.Contract__c+'_'+billingItem.Client__c;
        }
        else if((subscriptionDealer != null && billingItem.Client__r.AccountNumber == subscriptionDealer)
            || isTrackBalanceContractTypeDealer(billingItem)){
            if(isInstallment){
                return billingItem.Invoice__r.Type__c +'_'+ 
                billingItem.Installment_Event__r.Contract_Event__r.Contract__r.name+'_'+ billingItem.Client__c;
            }else if(billingItem.Contract_Event__c != null){
                return billingItem.Invoice__r.Type__c +'_'+ billingItem.Contract_Event__r.Contract__r.name+'_'+ billingItem.Client__c;
            }else {
                return billingItem.Invoice__r.Type__c +'_'+ getContractNameFromBillingItem(billingItem) + '_' + 
                    billingItem.Client__c;
            }            
        }
        else{
            return billingItem.Invoice__r.Type__c+'_'+billingItem.Writing_Company__c+'_'+billingItem.Client__c;
        }
    }
    
