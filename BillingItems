    public static void updateBalanceRemainingOnBillingItemFromOriginalReceipt(List<Billing_Item__c> billingItemList, 
        Map<Id, Decimal> mapOfRDIdAnd10BalanceRemaining, Map<Id, Decimal> mapOfRdIdAnd2GBalanceRemaining, Decimal oaAmount) {
        if(billingItemList != null && !billingItemList.isEmpty()) {
            List<Billing_Item__c> billingItemToUpdate = new List<Billing_Item__c>();
            for(Billing_Item__c billingItem : billingItemList) {
                if(billingItem.RD_Transaction__r.Accounting_Action__r.Name == AccountingActionConstants.ACCOUNTING_ACTION_2G && 
                    mapOfRdIdAnd2GBalanceRemaining.containsKey(billingItem.RD_Transaction__c)) {
                    billingItem.Balance_Remaining__c = (mapOfRdIdAnd2GBalanceRemaining.get(billingItem.RD_Transaction__c) + 
                        mapOfRDIdAnd10BalanceRemaining.values()[0]) - oaAmount;
                    billingItem.OA_Amount__c = (-1) * oaAmount;
                    billingItemToUpdate.add(billingItem);
                }
                else if(billingItem.RD_Transaction__r.Accounting_Action__r.Name == AccountingActionConstants.ACCOUNTING_ACTION_10) {
                    billingItem.Balance_Remaining__c = 0;
                    billingItemToUpdate.add(billingItem);
                }
            }
            if(billingItemToUpdate != null && !billingItemToUpdate.isEmpty()) {
                billingItemDAOInstance.updateBillingItemList(billingItemToUpdate);
            }
        }
    }

    public static Set<Id>  getBillingItemsToProcessForClientFee(List<Billing_Item__c> billingItems){
        Map<Id,Id> contractEventIdToBillingItemIdMap = new Map<Id,Id>();
        Set<Id> contractEventIds = new Set<Id>();
        List<Contract_Event__c> contractEvents = new List<Contract_Event__c>();
        Set<Id> billingItemsToReturn = new Set<Id>();
                   
        for(Billing_Item__c billingItem : billingItems){
            if(billingItem.Contract_Event__c != null){
                contractEventIds.add(billingItem.Contract_Event__c);
                contractEventIdToBillingItemIdMap.put(billingItem.Contract_Event__c, billingItem.Id);
            }
        }
       
        if(contractEventIds != null && contractEventIds.size() > 0){
            contractEvents = eventDaoWithoutSharingInstance.getContractEventsByIds(contractEventIds);
        }
        
        for(Contract_Event__c contractEvent:contractEvents){
            if(contractEvent.Contract__r != null && Contracts.isUSAutoContract(contractEvent.Contract__r.RecordTypeId) 
                && isEventClientFeeBucketsPopulated(contractEvent)){
                billingItemsToReturn.add(contractEventIdToBillingItemIdMap.get(contractEvent.Id));
            }
        }
        
        return billingItemsToReturn;
        
    }
    
    public static Boolean  isEventClientFeeBucketsPopulated(Contract_Event__c contractEvent){
        List<String> clientFeeFields = ClientFeeAllocationHeaderConstants.FEE_TYPE_TO_CLIENT_FEE_BUCKET_MAP.values();
        for(String clientFeeField:clientFeeFields){
            Decimal totalAmount = (Decimal)contractEvent.get(clientFeeField);
            Decimal originalTotalAmount = (Decimal)contractEvent.get('Original_'+clientFeeField);
            if(!ContractEventConstants.recordTypeIdsEligibleForPayeeDetailCreation.contains(contractEvent.RecordTypeId)){
                return false;
            }
            if(contractEvent.RecordType.DeveloperName == ContractEventConstants.NEW_BUSINESS_EVENT_TYPE){
                if(totalAmount != null && totalAmount > 0){
                    return true;
                }
            }
            else if((totalAmount != null && totalAmount > 0) || (originalTotalAmount != null && originalTotalAmount > 0)){
                return true;
            }
        }
        return false;       
    }
    
    public List<Billing_Item__c> updateExistingBillingItemsForAPACTFR(
        Map<String, Map<Id, Decimal>> mapOfBillingAndPaymentStatementWithAmount, Account_Payment__c accountPayment,
        String parentAccountNumber) {
        Map<Id, Decimal> mapOfBillingStatementIdWithAmount = mapOfBillingAndPaymentStatementWithAmount.get('BillingStatement');
        Map<Id, Decimal> mapOfPaymentStatementIdWithAmount = mapOfBillingAndPaymentStatementWithAmount.get('PaymentStatement');
        Map<Id, List<Billing_Item__c>> mapOfBillingItemsWithBillingStatementIds = new Map<Id, List<Billing_Item__c>>();
        Map<Id, List<Billing_Item__c>> mapOfBillingItemsWithPaymentStatementIds = new Map<Id, List<Billing_Item__c>>();
        List<Billing_Item__c> listOfBillingItemForUpdateOrInsert = new List<Billing_Item__c>();
        Id recordTypeIdForOutgoingPaymentBI = RecordTypeDAO.getRecordType('Outgoing_Payment', 'Billing_Item__c').Id;
        List<Id> listOfCasePayeeIdsToBeUpdated = new List<Id>();
        if (mapOfBillingStatementIdWithAmount != null && mapOfBillingStatementIdWithAmount.keySet().size() > 0) {
            List<Billing_Item__c>  listOfBillingItems = 
            billingItemDAOInstance.getBillingItemsByBillingStatementsAndOrderByCreatedDate(
            mapOfBillingStatementIdWithAmount.keySet());

            for(Billing_Item__c billingItem : listOfBillingItems) {
                if (!mapOfBillingItemsWithBillingStatementIds.containsKey(billingItem.Billing_Statement__c)) {
                    mapOfBillingItemsWithBillingStatementIds.put(billingItem.Billing_Statement__c, new List<Billing_Item__c>());  
                }
                mapOfBillingItemsWithBillingStatementIds.get(billingItem.Billing_Statement__c).add(billingItem);
                } 
        }
        if (mapOfPaymentStatementIdWithAmount != null && mapOfPaymentStatementIdWithAmount.keySet().size() > 0) {
            List<Billing_Item__c>  listOfBillingItems = 
                billingItemDAOInstance.getBillingItemsByPaymentStatementsAndOrderByCreatedDate(
                mapOfPaymentStatementIdWithAmount.keySet());
        
            for(Billing_Item__c billingItem : listOfBillingItems) {
                if (!mapOfBillingItemsWithPaymentStatementIds.containsKey(billingItem.Payment_Statement__c)) {
                    mapOfBillingItemsWithPaymentStatementIds.put(billingItem.Payment_Statement__c, new List<Billing_Item__c>());  
                }
                mapOfBillingItemsWithPaymentStatementIds.get(billingItem.Payment_Statement__c).add(billingItem);
            }  
        }
        for (Id recordId : mapOfBillingItemsWithBillingStatementIds.keySet()) {
            List<Billing_Item__c>  listOfBillingItems = mapOfBillingItemsWithBillingStatementIds.get(recordId);
            Decimal allocatedAmount = mapOfBillingStatementIdWithAmount.get(recordId);
            
            for (Billing_Item__c billingItem : listOfBillingItems) {
                if (Math.abs(billingItem.Balance_Remaining__c) > Math.abs(allocatedAmount)) {
                    billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c - allocatedAmount;
                    allocatedAmount = 0;
                    listOfBillingItemForUpdateOrInsert.add(billingItem);
                    break;
                } else {
                    Decimal remainingBalance = billingItem.Balance_Remaining__c;
                    billingItem.Balance_Remaining__c = 0;
                    allocatedAmount = allocatedAmount - remainingBalance;
                }
                listOfBillingItemForUpdateOrInsert.add(billingItem);
            }
        }
        for (Id recordId : mapOfBillingItemsWithPaymentStatementIds.keySet()) {
            List<Billing_Item__c>  listOfBillingItems = mapOfBillingItemsWithPaymentStatementIds.get(recordId);
            Billing_Item__c newBillingItemRecord;
            Decimal allocatedAmount = mapOfPaymentStatementIdWithAmount.get(recordId);
            for (Billing_Item__c billingItem : listOfBillingItems) {                
                if (Math.abs(billingItem.Balance_Remaining__c) > Math.abs(allocatedAmount)) {
                    billingItem.Balance_Remaining__c = billingItem.Balance_Remaining__c - allocatedAmount;
                    newBillingItemRecord = mapReverseBillingItemsForPaymentStatement(-Math.abs(allocatedAmount), 
                        recordTypeIdForOutgoingPaymentBI, BillingItemConstants.STATEMENT_TYPE_CLAIM_PAYMENT, 
                        billingItem.GL_Mapping_Type__c, billingItem.AIM_Client_Code__c, accountPayment, parentAccountNumber);
                    allocatedAmount = 0;
                    listOfBillingItemForUpdateOrInsert.add(billingItem);
                    listOfBillingItemForUpdateOrInsert.add(newBillingItemRecord);
                    break;
                } else {
                    Decimal remainingBalance = billingItem.Balance_Remaining__c;
                    billingItem.Balance_Remaining__c = 0;
                    allocatedAmount = allocatedAmount - remainingBalance;
                    listOfCasePayeeIdsToBeUpdated.add(billingItem.Case_Payee__c);
                    newBillingItemRecord = mapReverseBillingItemsForPaymentStatement(-Math.abs(remainingBalance), 
                        recordTypeIdForOutgoingPaymentBI, BillingItemConstants.STATEMENT_TYPE_CLAIM_PAYMENT, 
                        billingItem.GL_Mapping_Type__c, billingItem.AIM_Client_Code__c, accountPayment, parentAccountNumber);
                }
                listOfBillingItemForUpdateOrInsert.add(newBillingItemRecord);
                listOfBillingItemForUpdateOrInsert.add(billingItem);
            }
        }
        new CasePayees().updateCasePayeeToPaidStatus (listOfCasePayeeIdsToBeUpdated);
        return listOfBillingItemForUpdateOrInsert;
    }

